generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth & Benutzer ----------

model Role {
  id                 String   @id @default(cuid())
  name               String   @unique
  description        String?
  isSystem           Boolean  @default(false)
  isDefault          Boolean  @default(false)
  canAccessDashboard Boolean  @default(false)
  // Feste Anzeige-Reihenfolge in der Rollen-Liste (Nutzervorgabe,
  // 2026-08-16: Administrator, Manager, Redakteur, Gast statt
  // alphabetisch) – gleiches Muster wie `NavigationItem.sortOrder`.
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userRoles   UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id       String @id @default(cuid())
  resource String
  action   String

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // `@@id([userId, roleId])` deckt Lookups "Rollen eines Nutzers" ab
  // (userId führend), aber nicht "Nutzer einer Rolle" (roles-explorer.tsx
  // "Nutzer"-Popup, `UsersService.findAll({ roleId })`) – bei vielen
  // Nutzern pro Rolle (z.B. alle Fitnessstudio-Mitglieder in einer Rolle)
  // sonst ein voller Scan der Zwischentabelle.
  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model AppSettings {
  id                             Int         @id @default(1)
  // "master" (verwaltet Websites/stellt Lizenz-Tokens aus) oder "slave"
  // (eine ausgelieferte Installation, prüft wöchentlich beim Master) –
  // Nutzervorgabe, 2026-08-24: vom Pivot-Admin unter Einstellungen
  // umschaltbar statt nur per Umgebungsvariable. Sicherheitsrelevant:
  // steuert NUR lokale UI-Sichtbarkeit + ob die Websites-/Lizenz-
  // Endpunkte dieser Installation aktiv sind (siehe MasterOnlyGuard) –
  // niemals Zugriff auf andere Installationen, da jede ihre eigene,
  // isolierte Datenbank hat und der Signierschlüssel für echte Lizenz-
  // Tokens ausschließlich auf dem echten Master liegt (siehe
  // knowledge-base/platform/master-slave-licensing.md).
  deploymentMode                 String      @default("master")
  // Nur im Client-Modus relevant: der Schlüssel, mit dem sich DIESE
  // Installation beim Master ausweist (Nutzervorgabe, 2026-08-24: "eine
  // Eingabe, wo man den Schlüssel ändern kann" – bisher nur per
  // `LICENSE_API_KEY`-Umgebungsvariable + manuellem Neustart setzbar,
  // z.B. wenn der Master-Admin den Key regeneriert hat). Verschlüsselt wie
  // das SMTP-Passwort (`secret-encryption.ts`), nie im Klartext
  // zurückgegeben – schreibt-only-Feld wie `smtpPasswordEncrypted`. `null`
  // = noch nichts über die UI gesetzt, `LicenseClientService` fällt dann
  // auf die `LICENSE_API_KEY`-Umgebungsvariable zurück (Erstinbetriebnahme).
  licenseApiKeyEncrypted         String?
  allowRegistration              Boolean     @default(true)
  allowPasswordReset             Boolean     @default(true)
  // Getrennt nach Rolle (Nutzervorgabe, 2026-08-21): `allowEmailChange` gilt
  // für alle Nutzer außer Manager/Administrator/Pivot ("Benutzer können
  // E-Mail-Adresse anpassen"), `allowAdminEmailChange` eigens für
  // Administrator ("als Option in den Einstellungen"). Manager haben
  // bewusst KEINEN eigenen Schalter – sie dürfen ihre E-Mail-Adresse nie
  // selbst ändern ("manager nicht"). Pivot ist von beidem ausgenommen und
  // darf immer ändern (siehe UsersService.assertEmailChangeAllowed –
  // Pivot "kann alles").
  allowEmailChange               Boolean     @default(true)
  allowAdminEmailChange          Boolean     @default(true)
  requireAdminActivation         Boolean     @default(false)
  autosaveEnabled                Boolean     @default(true)
  mediaResponsiveVariantsEnabled Boolean     @default(true)
  maintenanceModeEnabled         Boolean     @default(false)
  // Inhalt der Wartungsseite, die eine Slave-Installation öffentlichen
  // Besuchern zeigt, sobald der Master sie sperrt (siehe
  // knowledge-base/platform/master-slave-licensing.md – "Wartungsseite
  // konfigurierbar"). Bewusst getrennt vom bestehenden
  // `maintenanceModeEnabled`-Schalter oben (eigenständiges, manuelles
  // Konzept). `null` = eingebauter Standardtext.
  maintenancePageTitle           String?
  maintenancePageMessage         String?
  mediaStorageQuotaMb            Int?
  // Maximale Dateigröße pro Upload (Nutzervorgabe, 2026-08-18) – gilt für
  // jeden Upload-Weg in der App (Medienbibliothek, Avatar, Firmenlogo,
  // alle laufen über MediaService.create()). null = keine Admin-Grenze,
  // nur die technischen Kategorie-Obergrenzen aus media.config.ts greifen
  // weiterhin. Ist ein Wert gesetzt, gilt das Minimum aus beiden – die
  // Kategorie-Obergrenze kann per Einstellung nur verschärft, nie
  // aufgeweicht werden.
  maxUploadSizeMb                Int?
  passwordMinLength              Int         @default(8)
  passwordRequireUppercase       Boolean     @default(true)
  passwordRequireLowercase       Boolean     @default(true)
  passwordRequireNumber          Boolean     @default(true)
  passwordRequireSpecialChar     Boolean     @default(true)
  defaultPageSize                Int         @default(10)
  // Globaler Schalter fürs gesamte 2FA/TOTP-Feature (Nutzervorgabe,
  // 2026-08-17) – bei false bleibt jeder vorhandene UserRole.twoFactorEnabled
  // wirkungslos (Login überspringt den zweiten Faktor komplett) und die
  // Einrichtung wird im Dashboard nirgends mehr angezeigt. Gleiche
  // "allow*"-Namenskonvention wie allowRegistration/allowPasswordReset.
  allowTwoFactor                 Boolean     @default(true)
  // Erzwingt bei aktivem allowTwoFactor, dass Administrator-Konten 2FA
  // eingerichtet haben, bevor der Rest des Dashboards nutzbar ist (siehe
  // TwoFactorSetupGuard) – gleiche "require*"-Konvention wie
  // requireAdminActivation.
  requireTwoFactorForAdmins      Boolean     @default(false)
  // Zusätzliche, feingranulare 2FA-Pflicht-Stufen (Nutzervorgabe,
  // 2026-08-17, "Sicherheit"-Tab-Redesign) – bestehen unabhängig
  // nebeneinander (jede kann für sich an/aus sein), TwoFactorSetupGuard
  // prüft alle drei ODER-verknüpft. "…ForAll" gilt für jedes Konto,
  // "…ForPublishers" nur für Rollen mit `content:publish`-Recht.
  requireTwoFactorForAll         Boolean     @default(false)
  requireTwoFactorForPublishers  Boolean     @default(false)
  // Passwort-Ablauf: erzwingt nach N Tagen seit der letzten Passwort-
  // Änderung (User.passwordChangedAt) beim nächsten Login einen
  // Passwortwechsel (setzt mustChangePassword, gleicher Mechanismus wie
  // requireAdminActivation). null = kein Ablauf.
  passwordExpiryDays             Int?
  // Sperrt ein Konto automatisch (isActive=false, gleicher Zustand wie
  // die manuelle "Sperren"-Aktion) nach N aufeinanderfolgenden
  // Fehlversuchen (siehe AuthService.login()). null = keine automatische
  // Sperre – User.failedLoginAttempts zählt dann weiterhin nur zur
  // Anzeige/Systembenachrichtigung.
  failedLoginLockoutThreshold    Int?
  // Prüft ein neues Passwort bei Registrierung/Passwortwechsel/-Reset
  // gegen die Have-I-Been-Pwned-Passwort-API (k-Anonymitäts-Abfrage,
  // Klartext-Passwort verlässt den Server nie – siehe
  // common/utils/pwned-password.ts).
  passwordBlockLeaked            Boolean     @default(false)
  // Verhindert die Wiederverwendung eines der letzten 5 Passwörter eines
  // Kontos (siehe PasswordHistory-Modell unten). Feste Anzahl 5 (wie in
  // der Bildvorlage "Letzte 5 Passwörter nicht erneut zulassen") statt
  // eines weiteren konfigurierbaren Zahlenfelds.
  passwordPreventReuseEnabled    Boolean     @default(false)
  // Beendet eine Sitzung (Refresh-Token), wenn seit der letzten
  // Token-Erneuerung mehr als N Minuten vergangen sind (siehe
  // RefreshToken.lastUsedAt, AuthService.refresh()). null = kein
  // Inaktivitäts-Timeout, nur die feste expiresAt-Ablaufzeit gilt.
  sessionIdleTimeoutMinutes      Int?
  // Darstellung (Nutzervorgabe, 2026-08-17, "Darstellung"-Tab-Redesign).
  // Hex-Farbe, null = Standard-Markenfarbe (#C8EE44, siehe globals.css).
  // Nur der Farbton wird übernommen (siehe lib/accent-color.ts) – Helligkeit
  // /Sättigung folgen demselben Muster wie die bisherige Lime-Palette, damit
  // Kontrast/Lesbarkeit für jede gewählte Farbe konsistent bleiben.
  accentColor                    String?
  // "compact" | "normal" | "airy" – Standard-Zeilenhöhe in Tabellen.
  tableDensity                   String      @default("normal")
  sidebarCollapsedByDefault      Boolean     @default(false)
  keyboardShortcutsEnabled       Boolean     @default(true)
  reduceMotion                   Boolean     @default(false)
  // "Frontend" = die öffentliche Website jeder Installation (Master wie
  // jeder Mandant), zu unterscheiden vom "Backend" (diesem Admin-UI hier
  // – siehe Begriffsklärung in
  // knowledge-base/frontend/taxonomy-management.md, Update 2026-08-31).
  // Diese Felder speisen deren `<head>`/SEO-Grundwerte; die Website
  // selbst ist noch nicht gebaut (siehe
  // knowledge-base/frontend/public-website.md-Plan), die Felder werden
  // hier bewusst vorbereitend angelegt, analog zu den bereits gebauten
  // `Category`-Feldern (rssEnabled usw.).
  siteTitle                      String?
  siteTagline                    String?
  faviconUrl                     String?
  defaultSeoDescription          String?
  defaultOgImageUrl              String?
  // Basis-URL der öffentlichen Website (z.B. "https://www.strasev.de"),
  // Grundlage für `Content.canonicalUrl`-Fallback und die Sitemap – jede
  // Installation (Master/Slave) trägt hier ihre EIGENE echte Domain ein,
  // keine Ableitung aus `Website.domain` (das ist eine Master-seitige,
  // Lizenz-interne Tabelle, siehe master-slave-licensing.md).
  publicBaseUrl                  String?
  // Welche `Navigation` das Hauptmenü der öffentlichen Website ist –
  // ohne dieses Feld gäbe es keine Möglichkeit, "das" Menü unter
  // mehreren `Navigation`-Datensätzen zu identifizieren.
  // Seit dem Footer (2026-09-02) verweist AppSettings DREIMAL auf
  // Navigation, deshalb tragen alle drei Relationen jetzt einen Namen –
  // Prisma kann sie sonst nicht auseinanderhalten. Dabei ist auch das
  // frühere `@unique` gefallen: es hätte verboten, dieselbe Navigation
  // gleichzeitig als Hauptmenü und als Footer-Spalte zu verwenden. Das
  // ist eine sinnvolle Möglichkeit, und es gibt ohnehin nur eine
  // AppSettings-Zeile.
  mainNavigationId               String?
  mainNavigation                 Navigation? @relation("MainNavigation", fields: [mainNavigationId], references: [id], onDelete: SetNull)
  // Die beiden freien Linkspalten im Footer der öffentlichen Website
  // (Nutzerentscheidung, 2026-09-02). Die Spaltenüberschrift ist der NAME
  // der Navigation ("Produkt", "Unternehmen") – bewusst kein zusätzliches
  // Titelfeld, das man doppelt pflegen müsste. Die dritte Spalte
  // (Rechtliches) kommt automatisch aus `LegalDocument` und braucht
  // deshalb keine Einstellung.
  footerNavigationPrimaryId      String?
  footerNavigationPrimary        Navigation? @relation("FooterNavigationPrimary", fields: [footerNavigationPrimaryId], references: [id], onDelete: SetNull)
  footerNavigationSecondaryId    String?
  footerNavigationSecondary      Navigation? @relation("FooterNavigationSecondary", fields: [footerNavigationSecondaryId], references: [id], onDelete: SetNull)
  // Freie Zeile rechts in der Footer-Fußleiste, gegenüber dem Copyright
  // (im Entwurf: "Hosting in Frankfurt · ISO 27001 · DSGVO"). Ohne Wert
  // bleibt die Stelle leer, statt einen Claim zu erfinden.
  footerNote                     String?
  // ---- Caching (Nutzervorgabe, 2026-09-03: eigener Bereich unter
  // Einstellungen mit Einstellungen und je einem Sofort-Leeren-Knopf) ----
  //
  // Backend: der prozessinterne CacheService (siehe cache/cache.service.ts).
  // Aus = jede Abfrage geht wieder direkt an die Datenbank.
  backendCacheEnabled            Boolean     @default(true)
  backendCacheTtlSeconds         Int         @default(30)
  // Frontend: wie lange apps/site Antworten der Content-Delivery-API
  // wiederverwendet. Der kleinste wählbare Wert ist bewusst 60 Sekunden –
  // die Seiten selbst stehen auf `export const revalidate = 60`, und das
  // muss ein Literal bleiben (Next.js wertet es statisch aus). Ein
  // kleinerer Wert hier wäre also wirkungslos und würde etwas versprechen,
  // was nicht eintritt.
  frontendCacheEnabled           Boolean     @default(true)
  frontendCacheTtlSeconds        Int         @default(60)

  // Abstand oben/unten für ALLE Seiten der öffentlichen Webseite, in
  // Pixeln, getrennt nach Breakpoint (Nutzervorgabe, 2026-09-03: "soll
  // global gesetzt werden für alle seiten"). Dieselben drei Stufen wie am
  // Menüpunkt und im Designer: mobil ist der Grundwert, Tablet ab 768px,
  // Desktop ab 1024px, jede erbt ohne eigenen Wert die nächstkleinere.
  //
  // Verhältnis zum Menüpunkt: der EINZELNE Wert am Menüpunkt sticht den
  // globalen, Seite für Seite und Wert für Wert (siehe
  // PublicContentService.resolveNavContext()). Global ist also die
  // Vorgabe, der Menüpunkt die Ausnahme.
  //
  // `null` = kein globaler Abstand, dann bleibt es beim Template.
  pageSpacingTopMobile     Int?
  pageSpacingBottomMobile  Int?
  pageSpacingTopTablet     Int?
  pageSpacingBottomTablet  Int?
  pageSpacingTopDesktop    Int?
  pageSpacingBottomDesktop Int?

  // Gilt der globale Abstand auch auf der Startseite? (Nutzervorgabe,
  // 2026-09-03: "zusätzlich einen Schalter, ob auf startseite ja oder
  // nein"). Hintergrund: Startseiten beginnen oft mit einem randlosen
  // Aufmacher, der bündig unter der Kopfzeile sitzen soll – während alle
  // übrigen Seiten Luft brauchen.
  //
  // Betrifft nur den GLOBALEN Wert. Ein am Startseiten-Menüpunkt gesetzter
  // Abstand ist eine ausdrückliche Ansage und wirkt weiterhin.
  pageSpacingOnHomepage    Boolean     @default(true)

  // Werte der Einstellungen, die das FRONTEND-TEMPLATE selbst deklariert
  // (Nutzerentscheidung, 2026-09-05). Schlüssel = `key` aus dessen
  // Manifest (`apps/site/src/template/manifest.ts`, ausgeliefert unter
  // `GET /api/template`).
  //
  // Bewusst EINE Json-Spalte und keine Spalte je Feld: welche Felder es
  // gibt, weiß nur das Template, und das ist pro Installation ein anderes.
  // Eine Schemaänderung für jede Farbe eines fremden Templates wäre der
  // sichere Weg in ein unpflegbares Modell.
  //
  // Preis dieser Wahl, bewusst in Kauf genommen: keine Typprüfung in der
  // Datenbank. Geprüft wird gegen das Manifest – in der Verwaltung beim
  // Rendern und in der API beim Speichern (unbekannte Schlüssel bleiben
  // erhalten, siehe resolveTemplateSettings()).
  templateSettings Json?

  // Ein HOCHGELADENES Template-Manifest (2026-09-05). Es sticht die Datei
  // im Frontend-Projekt (`apps/site/src/template/manifest.ts`), die damit
  // zur Vorgabe wird: `null` = die Datei gilt.
  //
  // Zweck: ein Template anpassen, ohne es neu zu deployen – Felder
  // umbenennen, gruppieren, ergänzen. Was der hochgeladene Stand NICHT
  // kann: dem Template neue Fähigkeiten geben. Eine deklarierte
  // CSS-Variable, die das Template nirgends benutzt, bleibt folgenlos;
  // ein Bereich, den es nicht rendert, erscheint nicht. Die Datei bleibt
  // die Wahrheit darüber, was WIRKT (siehe
  // knowledge-base/frontend/template-manifest.md).
  templateManifest Json?
  // Ein/Aus je Systembenachrichtigung-Kategorie (Nutzervorgabe, 2026-08-16:
  // Karte auf /dashboard/system-messages) – bestimmt, ob die jeweilige
  // Kategorie überhaupt als Banner/Glocken-Zähler auftaucht, unabhängig
  // vom zugrunde liegenden Zustand (z.B. Wartungsmodus kann aktiv sein,
  // aber die Benachrichtigung dazu ausgeblendet).
  notifyMaintenanceMode          Boolean     @default(true)
  notifyStorageQuota             Boolean     @default(true)
  notifyWebhookFailures          Boolean     @default(true)
  notifyLocalDrafts              Boolean     @default(true)
  notifyPendingActivations       Boolean     @default(true)
  notifyFailedLogins             Boolean     @default(true)
  notifyPendingPasswordChanges   Boolean     @default(true)
  // Nutzervorgabe, 2026-08-19: bestehende Inline-Warnhinweise (Firma-
  // Vollständigkeit, Datenschutz-Rechtstexte) müssen zusätzlich als
  // Systembenachrichtigung erscheinen, nicht nur lokal auf ihrer Seite.
  notifyCompanyIncomplete        Boolean     @default(true)
  notifyLegalDocuments           Boolean     @default(true)
  // Betroffenenanfragen-Automatik (Nutzervorgabe, 2026-08-19, Löschanfragen-
  // Neugestaltung): "Eingang automatisch bestätigen" (Mail an Absender bei
  // Anlage), "Erinnerung 7 Tage vor Fristende" (Mail an DSB, täglicher Cron).
  dsrAutoAcknowledgeReceipt      Boolean     @default(true)
  dsrDeadlineReminderEnabled     Boolean     @default(true)
  notifyDeletionRequests         Boolean     @default(true)
  notifyTrashExpiring            Boolean     @default(true)
  // Erinnerung, wenn Formular-Einsendungen zu lange ungelesen liegen
  // (Nutzervorgabe, 2026-09-02) – Schwelle in
  // formSubmissionUnreadReminderDays, täglicher Cron, Meldung erscheint
  // im zentralen Postfach /dashboard/system-messages.
  notifyUnreadSubmissions        Boolean     @default(true)
  // Master-seitige Live-Überwachung gesperrter Websites (Nutzervorgabe,
  // 2026-08-24: "baue einen test ein, der regelmäßig testet, ob eine
  // Seite live ist. wenn gesperrt, dennoch live, dass ich in Master
  // gewarnt werde") – siehe WebsiteMonitorService.
  notifyWebsiteAnomaly           Boolean     @default(true)

  // Schwellen der Plausibilitätsprüfung für die von Installationen selbst
  // gemeldeten Zählerstände (Nutzervorgabe, 2026-09-01: konfigurierbar
  // statt fest im Code, einstellbar unter Einstellungen → Verbindungen →
  // Master-Client). Ein Rückgang gilt erst als unglaubwürdig, wenn er
  // BEIDE Schwellen reißt – der Prozentwert allein würde bei kleinen
  // Beständen ständig auslösen (2 → 1 Nutzer sind -50 %), der absolute
  // allein bei großen nie. Siehe WebsitesService.recordStatsReport().
  statsAnomalyRelativeDropPercent     Int       @default(50)
  statsAnomalyAbsoluteDrop            Int       @default(5)
  // Gemeinsame Empfänger-Adresse für alle Systembenachrichtigungen
  // (Nutzervorgabe, 2026-08-22: "wie stelle ich ein, das die
  // benachrichtigungen an eine bestimmte email gesendet werden" – eine
  // Adresse für alle Kategorien statt pro Kategorie einzeln, analog zum
  // DSB-Kontakt). null = keine E-Mail-Zustellung, nur die bestehenden
  // In-App-Banner/Glocke (siehe NotificationsService.sync()).
  notificationRecipientEmail          String?
  // "Alle Jobs pausieren" auf dem neuen "Jobs"-Reiter (Nutzervorgabe,
  // 2026-08-22) – bewusst EIGENSTÄNDIG vom bestehenden
  // maintenanceModeEnabled (Nutzerentscheidung: kein gemeinsamer Schalter,
  // obwohl die Bildvorlage "Wartungsmodus" nennt). Kritische Jobs
  // (ScheduledJob.isCritical) ignorieren diesen Schalter.
  jobsGloballyPaused                  Boolean   @default(false)
  // "Job-Lauf-Historie aufräumen" (Nutzervorgabe, 2026-08-30: "bau das,
  // aber einstellbar unter einstellung- jobs") – `null` = unbegrenzt
  // aufbewahren (kein automatisches Löschen), gleiches Nullable-Muster
  // wie retentionFormSubmissionsDays.
  jobRunRetentionDays                 Int?      @default(90)
  // "Aktivitäten-Historie aufräumen" (Nutzervorgabe, 2026-08-30: "bitte
  // auch noch den aktivitäten history über sowas regeln") – räumt den
  // kompletten, geteilten `AuditLog` auf (Aktivität-Tab, Einstellungen-
  // Protokoll UND Datenschutz-Zugriffsprotokoll sind dieselbe Tabelle,
  // siehe AuditLogService). Ersetzt bewusst die bisherige rein manuelle
  // Zugriffsprotokoll-Löschliste durch eine harte automatische
  // Obergrenze (Nutzerentscheidung nach Rückfrage) – `null` = unbegrenzt,
  // gleiches Nullable-Muster wie jobRunRetentionDays. Default bewusst
  // 365 Tage (nicht 90 wie jobRunRetentionDays): retentionAccessLogMonths
  // (Default 12 Monate) ist bereits eine real konfigurierte
  // Datenschutz-Frist – ein kürzerer automatischer Default würde
  // Zugriffsprotokoll-Einträge löschen, bevor sie dort je zur manuellen
  // Review anstehen.
  activityLogRetentionDays            Int?      @default(365)
  // Auftragsverarbeiter-Tab, Karte "Drittlandtransfer" (Nutzervorgabe,
  // 2026-08-20): admin-hochgeladene SCC-Vorlage (Standardvertragsklauseln)
  // zum Download – kein erfundenes Rechtsmuster im Repo, echte Datei nötig.
  sccTemplateMediaId                  String?
  sccTemplateMedia                    Media?    @relation(fields: [sccTemplateMediaId], references: [id])
  // Einstellungen → Integrationen, Karte "Dienste" (Nutzervorgabe,
  // 2026-08-22: "email versand bauen ... als dienst", 1:1 nach
  // Bildvorlage "E-Mail-Versand (SMTP)"). smtpPasswordEncrypted nutzt
  // denselben AES-256-GCM-Helfer wie TOTP-Secrets (siehe
  // common/utils/secret-encryption.ts) statt Klartext-Speicherung.
  // smtpVerifiedAt wird bei jeder Konfigurationsänderung zurückgesetzt
  // und erst nach erfolgreichem Verbindungstest neu gesetzt – daraus
  // leitet sich der "aktiv"/"offen"-Status in der UI ab, kein separates
  // Status-Feld nötig.
  smtpHost                            String?
  smtpPort                            Int?
  smtpUsername                        String?
  smtpPasswordEncrypted               String?
  smtpFromAddress                     String?
  smtpFromName                        String?
  // "none" | "starttls" | "ssl"
  smtpSecure                          String    @default("starttls")
  smtpVerifiedAt                      DateTime?
  companyLogoUrl                      String?
  // Zweite, optionale Logo-Variante für Dark-Mode-fähige Oberflächen/
  // Mail-Clients (Nutzervorgabe, 2026-08-30: "setze bei Darstellung logo
  // einmal ein logo für lightmodus und für darkmodus") – `companyLogoUrl`
  // bleibt unverändert die Light-/Standard-Variante, kein Rename nötig.
  companyLogoUrlDark                  String?
  companyName                         String?
  companyStreet                       String?
  companyPostalCode                   String?
  companyCity                         String?
  companyCountry                      String?
  companyRepresentative               String?
  companyEmail                        String?
  companyPhone                        String?
  companyRegisterCourt                String?
  companyRegisterNumber               String?
  companyVatId                        String?
  // Firma-Seite (Nutzervorgabe, 2026-08-17, unter Verwaltung statt
  // Einstellungen) – ergänzt die bestehenden Firmenangaben um das in der
  // Bildvorlage gezeigte Feld "Aufsichtsbehörde" (z.B. Kammer bei
  // reglementierten Berufen).
  companySupervisoryAuthority         String?
  // Pflichtangaben-Check (Datenschutz → Rechtstexte, Nutzervorgabe
  // 2026-08-20, 1:1 nach Bildvorlage) – nach §36 VSBG vorgeschriebene
  // Streitschlichtungs-Angabe (Teilnahme an bzw. Verweis auf eine
  // Verbraucherschlichtungsstelle). "Berufsrechtliche Regelung" bewusst
  // NICHT ergänzt (Nutzervorgabe, gleicher Tag: "komplett weg") – nur für
  // reglementierte Berufe relevant, trifft auf diese Firma nicht zu.
  companyDisputeResolution            String?
  // Datenschutz-Seite (Nutzervorgabe, 2026-08-18, "Verwaltung → Datenschutz"
  // 1:1 nach Bildvorlage). Datenschutzbeauftragter: entweder eine externe
  // Person/Kanzlei (dpoIsExternal=true) oder intern benannt – reine
  // Kontaktfelder, keine eigene Rolle/Berechtigung.
  dpoIsExternal                       Boolean   @default(true)
  dpoName                             String?
  dpoCompany                          String?
  dpoEmail                            String?
  dpoPhone                            String?
  // Erweiterung "Datenschutzbeauftragter"-Tab (Nutzervorgabe, 2026-08-18,
  // 1:1 nach Bildvorlage). dpoSupervisoryAuthority ist bewusst ein eigenes
  // Feld statt companySupervisoryAuthority wiederzuverwenden: dort geht es
  // um berufsständische Kammern, hier um die für Datenschutz zuständige
  // Aufsichtsbehörde – zwei unterschiedliche reale Konzepte.
  dpoAppointedAt                      DateTime?
  dpoReportedAt                       DateTime?
  dpoSupervisoryAuthority             String?
  dpoLastContactAt                    DateTime?
  // Wirkt sich auf die Rechtstexte-Generierung aus (Impressum/
  // Datenschutzerklärung bekommen einen DSB-Absatz, siehe
  // LegalDocumentsService) – kein reiner Anzeige-Schalter.
  dpoListInLegalTexts                 Boolean   @default(false)
  // Löst beim Anlegen eines Vorfalls eine Mail (Dev-Stub wie alle
  // System-Mails, siehe MailerService) an dpoEmail aus.
  dpoNotifyOnIncident                 Boolean   @default(false)
  // Monatlicher Bericht per Cron (PrivacyReportSchedulerService), nutzt
  // denselben CSV-Generator wie der manuelle "Bericht erzeugen"-Button.
  dpoMonthlyReportEnabled             Boolean   @default(false)
  // Aufbewahrungsfristen – reine Richtwerte, KEINE automatische
  // Hintergrund-Löschung (explizite Nutzervorgabe: Löschung immer manuell
  // über die Review-Listen auf der Datenschutz-Seite). null bei
  // retentionFormSubmissionsDays = "unbegrenzt".
  //
  // AUSNAHME seit 2026-09-02: formSubmissionDeleteAfterReadDays unten
  // löscht als einzige Frist tatsächlich automatisch (Nutzervorgabe).
  retentionFormSubmissionsDays        Int?      @default(90)
  retentionAccessLogMonths            Int       @default(12)
  retentionDeactivatedAccountsMonths  Int       @default(6)
  retentionTrashDays                  Int       @default(30)
  // Betroffenenrechte-Kachel (Datenschutz → Rechtstexte, Art. 15/17 DSGVO,
  // Nutzervorgabe 2026-08-19).
  //
  // dsbFormSelfServiceDisclosure hat weiterhin KEINEN Verbraucher – es
  // gibt keinen Formular-Footer, der ihn auswerten würde. (Die frühere
  // Begründung "kein Formular-Modul vorhanden" stimmt seit dem
  // Formulare-Feature nicht mehr und ist 2026-09-02 korrigiert worden;
  // Formulare sind kein Modul und werden auch nie eins, siehe
  // websites/module-catalog.ts.)
  dsbFormSelfServiceDisclosure        Boolean   @default(false)
  // Wirkt dagegen echt: FormsService.submit() speichert submitterIp nur,
  // wenn dieser Schalter an ist.
  dsbFormStoreSubmissionIp            Boolean   @default(false)
  // Datenschutz → Reiter "Formulare" (Nutzerentscheidung, 2026-09-02).
  // Anzahl Tage NACH dem Lesen, nach denen eine Einsendung endgültig
  // gelöscht wird; null = nie. Anders als alle übrigen Fristen oben wirkt
  // diese wirklich automatisch (täglicher Cron) – gemessen ab
  // FormSubmission.readAt, nicht ab Eingang.
  formSubmissionDeleteAfterReadDays   Int?
  // Gegenstück für NIE gelesene Einsendungen (Nutzervorgabe, 2026-09-02).
  // Ohne diese Frist konnten sie unbegrenzt liegen bleiben – die
  // datenschutzrechtlich unangenehmere Sorte, weil sie personenbezogene
  // Daten enthalten, die nie jemand angesehen hat. Bewusst ab EINGANG
  // gerechnet (es gibt kein readAt) und bewusst deutlich großzügiger als
  // die Lese-Frist: was niemand gelesen hat, soll nicht nach wenigen
  // Tagen verschwinden. null = nie.
  formSubmissionDeleteUnreadAfterDays Int?
  // Einstellungen → Mailing → Reiter "Einsendungen" (Nutzervorgabe,
  // 2026-09-02). Bis dahin gab es global gar nichts: die Admin-Mail ging
  // immer raus, sobald irgendein Empfänger auflösbar war.
  formSubmissionNotifyOnNew           Boolean   @default(true)
  // Eigener Empfänger für Formular-Benachrichtigungen. Leer = weiterhin
  // Rückfall auf notificationRecipientEmail (bisheriges Verhalten). Ein
  // am Formular gesetzter Empfänger (MailTemplate.recipientTo) hat
  // weiterhin Vorrang vor beidem.
  formSubmissionRecipientEmail        String?
  // Vorbelegung von Form.sendConfirmation für NEU angelegte Formulare –
  // ändert nichts an bestehenden.
  formSubmissionConfirmationDefault   Boolean   @default(false)
  // Erinnerung, wenn Einsendungen so viele Tage ungelesen liegen;
  // null = keine Erinnerung. Siehe notifyUnreadSubmissions.
  formSubmissionUnreadReminderDays    Int?
  updatedAt                           DateTime  @updatedAt

  @@map("app_settings")
}

// Datenschutz-Seite → Tab "Rechtstexte" (Nutzervorgabe, 2026-08-18): aus den
// Firmen-Stammdaten (AppSettings.company*) generierte Rechtstexte.
// `generatedContent` wird bei "Neu erzeugen" komplett ersetzt,
// `manualAddendum` bleibt dabei unangetastet (manuelle Ergänzungen bleiben
// erhalten). "Veraltet" wird nicht über ein eigenes Feld getrackt, sondern
// dynamisch geprüft: lastGeneratedAt vs. neuester company.field_updated
// AuditLog-Eintrag (siehe LegalDocumentsService).
model LegalDocument {
  id               String    @id @default(cuid())
  key              String    @unique
  title            String
  slug             String
  generatedContent String    @db.Text
  manualAddendum   String?   @db.Text
  lastGeneratedAt  DateTime?
  // Verknüpfter echter Content-Eintrag (Nutzervorgabe, 2026-08-18: Rechtstexte
  // sollen auch als echte Seite unter "Seiten" auftauchen, nicht nur in dieser
  // Tabelle). Lose Referenz (kein FK) wie an anderen Stellen in der App (z.B.
  // Medien-Referenzen per URL) – wird bei "Neu erzeugen" angelegt/aktualisiert.
  contentId        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("legal_documents")
}

// Datenschutz-Seite → restliche Tabs (Nutzervorgabe, 2026-08-18): einfache
// echte Listen ohne Bildvorlage ("einfache echte Listen jetzt"), bewusst
// schlank gehalten (nur die Felder, die für Titel/Status/Zähler auf der
// Übersichtsseite gebraucht werden), kein Pixel-Mockup zum Nachbauen.
/// Betroffenenanfragen-Log (Nutzervorgabe, 2026-08-19: Neugestaltung nach
/// Bildvorlage) – trotz Modellnamens nicht mehr nur Löschanfragen, deckt
/// alle drei DSGVO-Anfragearten ab (`type`). Bewusst dauerhaft aufbewahrt,
/// auch wenn der anfragende Nutzer später gelöscht/anonymisiert wird –
/// Rechenschaftspflicht (Art. 5(2) DSGVO): Name/E-Mail bleiben als freier
/// Text erhalten, unabhängig vom optionalen `linkedUser`.
model DeletionRequest {
  id                   String    @id @default(cuid())
  // "DSR-2026-014" – pro Kalenderjahr fortlaufend, siehe generateDsrId()
  // in DeletionRequestsService. Als String statt reiner Zahl gespeichert,
  // damit der Wert nach dem Anlegen stabil bleibt (kein Neuberechnen).
  dsrId                String    @unique
  type                 String    @default("deletion") // deletion | access | rectification
  requesterName        String
  requesterEmail       String
  reason               String?
  // Woher die Anfrage kam (Formular, Telefon, Post, ...) – freier Text,
  // da es kein Formular-Modul mit fester Quellen-Liste gibt.
  source               String?
  affectedRecordsCount Int?
  // Nachträgliche Verknüpfung mit einem echten Konto (Nutzervorgabe:
  // "wenn ein echtes Konto vorhanden ist, dann verknüpfen") – gesetzt,
  // sobald "Datenauszug erstellen" per E-Mail-Abgleich einen Treffer
  // findet. Absichtlich nullable/lose: die Anfrage bleibt auch bestehen,
  // wenn das verknüpfte Konto später anonymisiert wird.
  linkedUserId         String?
  linkedUser           User?     @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)
  status               String    @default("open") // open | in_progress | completed | rejected
  dueAt                DateTime?
  completedAt          DateTime?
  // "Erinnerung 7 Tage vor Fristende" – verhindert doppelten Versand
  // durch den täglichen Cron.
  reminderSentAt       DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("deletion_requests")
}

model ProcessingActivity {
  id              String   @id @default(cuid())
  purpose         String
  legalBasis      String?
  dataCategories  String?
  // Löschfrist/Aufbewahrungsdauer für diesen Verarbeitungszweck (Art. 30(1)f
  // DSGVO) – Freitext statt Zahl+Einheit, da die Bildvorlage gemischte
  // Formate zeigt ("90 Tage", "bis Widerruf", "10 Jahre").
  retentionPeriod String?
  recipients      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("processing_activities")
}

model DataProcessor {
  id             String    @id @default(cuid())
  name           String
  purpose        String?
  hasContract    Boolean   @default(false)
  contractDate   DateTime?
  // Nutzervorgabe, 2026-08-20 ("setze auftragsverarbeiter genau nach
  // screener um"): Ort (z.B. "Hamburg, DE"), Zusatzhinweis in der
  // Listenzeile (z.B. "ISO 27001", "Angemessenheitsbeschluss", "eigener
  // Server", "SCC ausstehend" – freier Text, keine Ableitung aus dem Ort),
  // manuelles Häkchen für Drittlandtransfer (keine automatische EU-Länder-
  // Erkennung aus Freitext) und eine Kontaktadresse für "AV-Vertrag
  // anfordern".
  location       String?
  complianceNote String?
  outsideEu      Boolean   @default(false)
  contactEmail   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Hochgeladene Vertrags-PDF (Ordner "AVs", siehe seed.ts) – getrennt von
  // `hasContract` (bleibt der manuelle Ja/Nein-Haken für "AV-Vertrag
  // vorhanden", auch ohne hochgeladene Datei, z.B. bei Papierverträgen).
  // "AV-Vertrag herunterladen" auf der Datenschutz-Seite zippt den ganzen
  // "AVs"-Ordner, nicht gezielt diese Relation – die Relation ist für die
  // Anzeige/Verlinkung je Auftragsverarbeiter (Nutzervorgabe, 2026-08-19).
  contractMediaId String?
  contractMedia   Media?  @relation(fields: [contractMediaId], references: [id])

  @@map("data_processors")
}

// Datenschutz-Seite → Tab "Vorfälle" (Nutzervorgabe, 2026-08-20, 1:1 nach
// Bildvorlage): Art. 33/34 DSGVO-Meldeworkflow. `occurredAt` = "Bekannt
// geworden" (der Art.-33-Fristbeginn ist der Zeitpunkt der Kenntnisnahme,
// nicht des eigentlichen Vorfalls). `status` bleibt unverändert die grobe
// Offen/Behoben-Ampel fürs Dashboard (`PrivacyService`) – die neue,
// granularere Ablauf-Anzeige im Tab selbst wird rein aus severity +
// authorityNotifiedAt/subjectsNotifiedAt/measuresDocumented berechnet,
// nicht aus einem weiteren gespeicherten Status (gleiches Prinzip wie
// "Veraltet" bei LegalDocument: dynamisch geprüft statt eigenes Feld).
// severity="low" ("kein Risiko" bewertet) macht alle drei Meldeschritte
// gegenstandslos – Art. 33/34 verlangen dann keine Meldung/Information.
model PrivacyIncident {
  id                  String    @id @default(cuid())
  title               String
  description         String?
  severity            String    @default("low") // low | medium | high
  status              String    @default("open") // open | resolved
  occurredAt          DateTime?
  affectedCount       Int?
  authorityNotifiedAt DateTime?
  subjectsNotifiedAt  DateTime?
  measuresDocumented  String?   @db.Text
  resolvedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("privacy_incidents")
}

// Firma-Seite → Tab "Standorte" (Nutzervorgabe, 2026-08-17): mehrere
// Adressen derselben (einen) Firma – kein Mandanten-/Multi-Firmen-Konzept
// ("es soll nur eine Firma unter Verwaltung geben"), nur eine Liste
// zusätzlicher Adressen. `employeeCount` ist ein manuell vom Admin
// gepflegtes Zahlenfeld (keine echte Mitarbeiterverwaltung in dieser App)
// – kein erfundener, automatisch berechneter Wert. `openingHours` gab es
// hier zwischenzeitlich, wurde aber komplett entfernt statt nur
// ausgeblendet (Nutzervorgabe, 2026-08-20: "setzen wir anders später um")
// – soll später in anderer Form wiederkommen, kein Platzhalterfeld
// bis dahin.
model CompanyLocation {
  id            String   @id @default(cuid())
  name          String
  isPrimary     Boolean  @default(false)
  street        String?
  postalCode    String?
  city          String?
  phone         String?
  email         String?
  employeeCount Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("company_locations")
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String
  firstName              String?
  lastName               String
  avatarUrl              String?
  department             String?
  phone                  String?
  // Nutzervorgabe, 2026-08-19: "bei mein profil und benutzer detail
  // strasse, plz ort mit aufnehmen. berücksichtige das bei allem
  // datenschutzauskünften" – fließt in den Art.-15-Datenauszug
  // (PrivacyService.generateSubjectAccessReportCsv) mit ein.
  street                 String?
  postalCode             String?
  city                   String?
  isActive               Boolean   @default(true)
  // Zeitpunkt, seit dem `isActive` zuletzt auf false steht – Grundlage für
  // die Datenschutz-Aufbewahrungsfrist "Deaktivierte Konten" (siehe
  // AppSettings.retentionDeactivatedAccountsMonths). Wird bei Deaktivierung
  // gesetzt und bei Reaktivierung wieder auf null geräumt (gleiches Muster
  // wie pendingActivation).
  deactivatedAt          DateTime?
  // Selbstregistrierung bei aktivierter `AppSettings.requireAdminActivation`
  // (siehe AuthService.register()) – unterscheidet "wartet auf
  // Freischaltung" von einer normalen, von einem Admin deaktivierten
  // Zeile (beide haben `isActive: false`, aber nur diese hier braucht eine
  // Systembenachrichtigung). Wird gelöscht, sobald `isActive` auf `true`
  // gesetzt wird (siehe UsersService.update()).
  pendingActivation      Boolean   @default(false)
  emailVerifiedAt        DateTime?
  lastLoginAt            DateTime?
  // Erzwingt beim nächsten Login einen Passwortwechsel, bevor der Rest des
  // Dashboards nutzbar ist (siehe `RequirePasswordChangeGuard`).
  mustChangePassword     Boolean   @default(false)
  // Zählt fehlgeschlagene Login-Versuche in Folge, wird bei erfolgreichem
  // Login zurückgesetzt (siehe `AuthService.login()`). Aktuell nur
  // Anzeige im "Konto"-Kasten, keine automatische Sperre nach X Versuchen.
  failedLoginAttempts    Int       @default(0)
  // Zeitpunkt der letzten Passwort-Änderung (Erstanlage, Self-Service-
  // Änderung, Reset) – Grundlage für AppSettings.passwordExpiryDays.
  // Bewusst kein Rückwirkungs-Backfill nötig: NULL zählt in der
  // Ablauf-Prüfung als "läuft nie ab", bis das Passwort das erste Mal
  // nach Einführung dieses Felds geändert wird (kein erfundener Wert für
  // bereits bestehende Konten).
  passwordChangedAt      DateTime?
  // Zeitpunkt der Anonymisierung ("Benutzer löschen", nicht reversibel) –
  // unterscheidet den Zustand von einer normalen Deaktivierung
  // (`isActive: false`, reversibel). Siehe UsersService.anonymize().
  anonymizedAt           DateTime?
  // Drei getrennte Zustände (Nutzervorgabe, 2026-08-21: "unterscheide
  // zwischen löschen und sperren, das sind 2 unterschiedliche zustände" –
  // vorher teilten sich "Sperren" (Benutzerliste) und "Löschen"
  // (Bearbeiten-Seite) dieselbe `remove()`/isActive:false-Aktion, was
  // niemand nachvollziehen konnte):
  // 1. Gesperrt (`isActive: false` + `deactivatedAt`) – reversibel, bleibt
  //    in der Benutzerliste, kann jederzeit entsperrt werden.
  // 2. Gelöscht (`deletedAt`) – verschwindet aus der Benutzerliste,
  //    taucht stattdessen unter Datenschutz → "Nutzer" auf. Noch nicht
  //    anonymisiert, `email`/Name etc. bleiben vorerst erhalten.
  // 3. Anonymisiert (`anonymizedAt`) – nur noch von dort aus auslösbar,
  //    endgültig, personenbezogene Daten entfernt.
  deletedAt              DateTime?
  // TOTP-2FA (Nutzervorgabe, 2026-08-17). `twoFactorSecret` liegt
  // AES-256-GCM-verschlüsselt vor (siehe totp-encryption.ts) – anders als
  // Passwort-/Token-Hashes muss das Secret bei jeder Login-Prüfung wieder
  // im Klartext vorliegen, Hashing wie bei passwordHash scheidet aus.
  // `twoFactorEnabled` bleibt false, bis der erste Code nach dem Scannen
  // bestätigt wurde (TwoFactorService.verifySetup) – ein nur generiertes,
  // nie bestätigtes Secret aktiviert 2FA nicht. `twoFactorRecoveryCodes`
  // sind einzeln argon2-gehashte Einmal-Codes, verbrauchte werden aus dem
  // Array entfernt (siehe AuthService.loginWithTwoFactor()).
  twoFactorSecret        String?
  twoFactorEnabled       Boolean   @default(false)
  // Nur zur Anzeige ("eingerichtet am ..." auf "Mein Konto") – bewusst
  // kein erfundener Wert, wird bei jeder verifyTwoFactorSetup() gesetzt.
  twoFactorEnabledAt     DateTime?
  twoFactorRecoveryCodes String[]  @default([])
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  userRoles UserRole[]

  contents                Content[]                @relation("ContentAuthor")
  lockedContents          Content[]                @relation("ContentLockedBy")
  // Papierkorb (Nutzervorgabe, 2026-08-18): wer hat den Eintrag gelöscht
  // (in den Papierkorb verschoben) – für die "Gelöscht von"-Spalte auf
  // der Papierkorb-Seite.
  deletedContents         Content[]                @relation("ContentDeletedBy")
  deletedMedia            Media[]                  @relation("MediaDeletedBy")
  deletedCategories       Category[]               @relation("CategoryDeletedBy")
  deletedTags             Tag[]                    @relation("TagDeletedBy")
  deletedGlobalModules    GlobalModule[]           @relation("GlobalModuleDeletedBy")
  deletedForms            Form[]                   @relation("FormDeletedBy")
  createdPreviewTokens    ContentPreviewToken[]
  contentVersions         ContentVersion[]
  media                   Media[]                  @relation("MediaUploadedBy")
  auditLogs               AuditLog[]
  refreshTokens           RefreshToken[]
  passwordHistory         PasswordHistory[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  // Betroffenenanfragen-Log (Nutzervorgabe, 2026-08-19): "Datenauszug
  // erstellen" verknüpft eine Anfrage nachträglich mit einem echten Konto,
  // wenn die E-Mail-Adresse übereinstimmt.
  linkedDeletionRequests  DeletionRequest[]
  notifications           Notification[]

  // Für UsersService.getNotificationCounts() (2b.14): die App ist nicht
  // auf eine kleine, feste Admin-Zahl beschränkt – Kundenkonten (z.B.
  // Fitnessstudio-Mitglieder) laufen über dasselbe `User`-Modell und
  // können in die Zehntausende gehen. Ohne diese Indizes würde jede der
  // drei COUNT-Abfragen (läuft bei jeder Dashboard-Navigation für Nutzer
  // mit `users:read`) einen vollen Tabellen-Scan brauchen.
  @@index([pendingActivation, anonymizedAt])
  @@index([isActive, anonymizedAt, failedLoginAttempts])
  @@index([mustChangePassword, isActive, anonymizedAt])
  @@map("users")
}

// Benachrichtigungs-Postfach (Nutzervorgabe, 2026-08-21, 1:1 nach
// Bildvorlage: "setze systembenachrichtigungen genau wie auf dem screener
// um"). Ersetzt die bisherigen zustandslosen, live berechneten
// SystemMessage-Banner (Wartungsmodus/Speicherplatz/Webhooks/etc.) NICHT –
// `NotificationsService.sync()` prüft dieselben Bedingungen wie zuvor
// `system-messages/page.tsx` und legt für jede zutreffende, noch nicht
// vorhandene Bedingung genau einmal eine Zeile an (Dedupe über
// `[userId, dedupeKey]`), damit "gelesen"/"erledigt" echt und dauerhaft
// pro Nutzer gespeichert werden kann, statt bei jedem Seitenaufruf neu
// berechnet zu werden. Bewusst NICHT umgesetzt (kein erfundenes Feature):
// "Freigaben" (Freigabe-Workflow) und "Kommentare" gibt es in dieser App
// nicht (Nutzerentscheidung, 2026-08-21: "weglassen"); ebenso keine
// "Formulare"-Kategorie als Benachrichtigungs-Bereich (seit 2026-09-02
// gibt es stattdessen die Kategorie notifyUnreadSubmissions), kein
// Konten-ohne-
// 2FA-/Geo-Anomalie-Check (existieren nicht als berechnete Bedingung) und
// keine Ruhezeiten (Digest/Zeitfenster) – Nutzerentscheidung, 2026-08-22:
// "sofort bei jedem neuen Vorfall" statt gesammelt. E-Mail-Zustellung an
// AppSettings.notificationRecipientEmail gibt es seit demselben Tag (siehe
// NotificationEmailLog unten) – vorher gab es dafür keinen echten
// Mail-Versand, nur die In-App-Banner/Glocke.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // system | security | privacy | accounts – bewusst nur die vier
  // Kategorien mit echter Datengrundlage, siehe Kommentar oben.
  category    String
  // Stabiler Schlüssel für die Dedupe-Prüfung in sync(), z.B.
  // "webhook-failure:<webhookId>" oder "storage-quota" – verhindert
  // Doppeleinträge bei jedem erneuten Sync, solange die Bedingung anhält.
  dedupeKey   String
  title       String
  description String
  // null = "System" als Akteur (siehe UI) statt eines erfundenen Namens.
  actorName   String?
  isUrgent    Boolean   @default(false)
  actionLabel String?
  actionUrl   String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  // "Erledigt" wird ausschließlich durch Klick auf den Aktions-Button
  // gesetzt (NotificationsService.markResolved()), nicht automatisch,
  // wenn die zugrunde liegende Bedingung nicht mehr zutrifft – der Log
  // bleibt dadurch ein echter Verlauf statt sich selbst zu leeren.
  isResolved  Boolean   @default(false)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("notifications")
}

// Verhindert Mail-Duplikate bei der gemeinsamen Empfänger-Adresse
// (Nutzervorgabe, 2026-08-22): `Notification`-Zeilen existieren pro
// Nutzer (`[userId, dedupeKey]`), `sync()` läuft aber unabhängig für
// jeden Nutzer, der die Benachrichtigungen öffnet – ohne diese separate,
// rein nach `dedupeKey` (nutzerunabhängig) geführte Tabelle würde jeder
// Admin, der als Erster nach einem neuen Vorfall die Seite lädt, eine
// eigene Mail auslösen. Ein Eintrag hier = für diesen `dedupeKey` wurde
// bereits gemailt; wird gelöscht, sobald die Bedingung wieder auflöst
// (siehe NotificationsService.sync()), damit ein erneutes Auftreten
// wieder eine Mail auslöst.
model NotificationEmailLog {
  dedupeKey String   @id
  sentAt    DateTime @default(now())

  @@map("notification_email_log")
}

// Einstellungen → "Jobs"-Reiter (Nutzervorgabe, 2026-08-22, 1:1 nach
// Bildvorlage "Geplante Aufgaben"/"Letzte Läufe"). `id` ist ein stabiler,
// im Code vergebener Schlüssel (z.B. "content-publish"), keine generierte
// ID – JobsService.onModuleInit() sorgt per Upsert dafür, dass für jeden
// tatsächlich im Code registrierten Job (siehe JobsService.definitions)
// genau eine Zeile existiert. NUR die drei bereits real vorhandenen
// Cron-Jobs (vorher `@Cron()`-Dekoratoren in ContentSchedulerService/
// DeletionRequestReminderSchedulerService/PrivacyReportSchedulerService,
// jetzt hier dynamisch über `SchedulerRegistry` verwaltet, damit
// `cronExpression` zur Laufzeit editierbar ist) – bewusst KEINE
// Bildvorlage-Jobs ohne echte Grundlage (Papierkorb-Auto-Löschung,
// Sitemap/Suchindex, Link-Check, Backup gibt es in dieser App nicht).
model ScheduledJob {
  id                String    @id
  cronExpression    String
  isPaused          Boolean   @default(false)
  // Kritische Jobs lassen sich nicht (auch nicht einzeln) pausieren und
  // ignorieren den globalen "Alle Jobs pausieren"-Schalter (siehe
  // AppSettings.jobsGloballyPaused) – Admin legt das selbst fest, kein
  // Job ist im Code fest als kritisch vorgegeben.
  isCritical        Boolean   @default(false)
  // Mailt bei einem fehlgeschlagenen Lauf an AppSettings.
  // notificationRecipientEmail (Nutzerentscheidung, 2026-08-22: denselben
  // Empfänger wiederverwenden statt ein eigenes Feld nur für Job-Fehler).
  notifyOnFailure   Boolean   @default(false)
  lastRunAt         DateTime?
  lastRunDurationMs Int?
  // "success" | "error"
  lastRunStatus     String?
  lastRunMessage    String?
  totalRuns         Int       @default(0)
  totalErrors       Int       @default(0)
  updatedAt         DateTime  @updatedAt

  runs JobRun[]

  @@map("scheduled_jobs")
}

// Einzelner Lauf eines ScheduledJob – Grundlage für die "Letzte Läufe"-
// Karte (app-weit über alle Jobs, mit Pagination) und den "Letztes
// Protokoll"-Dialog (auf einen Job gefiltert). Ein pausierter Job erzeugt
// bewusst KEINE Zeile hier ("wird übersprungen, nicht nachgeholt" laut
// Bildvorlage) – nur tatsächlich ausgeführte Läufe.
model JobRun {
  id         String       @id @default(cuid())
  jobId      String
  job        ScheduledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  startedAt  DateTime     @default(now())
  durationMs Int
  status     String
  message    String?

  @@index([jobId, startedAt])
  @@index([startedAt])
  @@map("job_runs")
}

model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  // Für "Aktive Sitzungen" (2b.14): Roh-User-Agent + IP der Anfrage bei
  // Ausstellung. Kein Geolocation-Dienst angebunden – Anzeige nutzt die
  // IP-Adresse direkt statt einer (sonst erfundenen) Stadt.
  userAgent  String?
  ipAddress  String?
  // Für AppSettings.sessionIdleTimeoutMinutes: bei jedem Refresh
  // aktualisiert (siehe AuthService.refresh()), Startwert = createdAt.
  lastUsedAt DateTime  @default(now())

  @@map("refresh_tokens")
}

// Letzte Passwort-Hashes pro Konto, für AppSettings.passwordPreventReuseEnabled
// ("letzte 5 Passwörter nicht erneut zulassen") – argon2-gehasht wie
// User.passwordHash, nie im Klartext. Älteste Einträge über die feste
// Grenze hinaus werden bei jeder Passwort-Änderung gelöscht (siehe
// AuthService.recordPasswordHistory()).
model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("password_history")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

// ---------- Content ----------

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

// Kategorien-Seite, "Sortierung" unter Kategorie-Einstellungen, siehe
// Category.sortOrder.
enum CategorySortOrder {
  NEWEST
  OLDEST
  MANUAL
}

model ContentType {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  // JSON-Schema-artige Feld-Definition fuer flexible Content-Modelle
  schema    Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  contents  Content[]

  @@map("content_types")
}

// Modul-Typ für den Seiten-Designer (Drag&Drop-Bausteine, siehe
// knowledge-base/content/page-designer.md). Gleiche Schema-Form wie
// ContentType.schema ({ fields: [{name,type,required}] }), damit die
// vorhandene dynamische Formular-Generierung wiederverwendet werden
// kann. Modul-Instanzen selbst leben (wie andere dynamische
// Feldwerte auch) eingebettet in Content.data, keine eigene Tabelle.
model ModuleType {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  schema    Json
  // Reihenfolge in der Baustein-Palette des Seiten-Designers
  // (Nutzervorgabe, 2026-09-03: "Reihenfolge der Bausteine im Designer per
  // Drag and Drop festlegen"). Vorher standen sie alphabetisch – die
  // meistgenutzten Bausteine landeten dadurch zufällig verteilt.
  //
  // Alle mit 0 vorbelegt; solange niemand etwas verschoben hat, entscheidet
  // weiterhin der Name (zweites Sortierkriterium in findAll()).
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  globalModules GlobalModule[]

  @@map("module_types")
}

// Ein einmal gepflegter Modul-Inhalt, der per Referenz (`globalModuleId`
// auf `ModuleInstance` im Block-Editor) auf beliebig vielen Seiten
// eingebunden werden kann – anders als ein normaler Baustein-Inhalt, der
// als Snapshot direkt in `Content.data` liegt. `values` wird bei jedem
// Request live aufgelöst (siehe apps/web BlockEditorField/BlockFieldOutput
// `resolveInstanceValues`), nicht als Kopie in die einbindenden Seiten
// geschrieben – Änderungen wirken sich dadurch sofort überall aus.
/// Inhalt eines Bereichs, den das Frontend-Template deklariert hat
/// (Kopfbereich, Fußbereich, Aktionsband … – siehe `regions` im Manifest,
/// apps/site/src/template/manifest.ts). Stufe 2 der Template-Mechanik,
/// Nutzervorgabe 2026-09-05: *"können wir das bausteinmäßig machen … also
/// sowas wie header content und footer"*.
///
/// Ein Bereich ist inhaltlich dasselbe wie eine Seite: eine Liste von
/// Bausteinen unter `data.blocks`, gerendert vom selben Renderer.
///
/// **Warum ein eigenes Modell und kein `Content` mit eigenem Typ:** eine
/// Seite hat Slug, Status, Kategorien, SEO-Felder, Versionen und einen
/// Papierkorb – für einen Bereich ist davon nichts sinnvoll (er hat keine
/// eigene URL und wird nicht "veröffentlicht", er ist einfach da). Ein
/// Content-Datensatz mit einem Dutzend bedeutungsloser Spalten wäre eine
/// Einladung zu Fehlern, etwa einem Bereich im Papierkorb.
///
/// Der Preis: keine Versionshistorie für Bereiche. Bewusst – siehe
/// knowledge-base/frontend/template-manifest.md.
model TemplateRegionContent {
  id String @id @default(cuid())

  /// Schlüssel aus dem Manifest (`header`, `footer`, …). Eindeutig: pro
  /// Installation gibt es genau EINEN Inhalt je Bereich.
  ///
  /// Steht ein Schlüssel hier, den das Manifest (nicht mehr) kennt, wird
  /// er nirgends gerendert, aber auch nicht gelöscht – dasselbe Prinzip
  /// wie bei den Template-Einstellungen.
  key String @unique

  /// Bausteine des Bereichs, gleiche Form wie `Content.data`
  /// (`{ blocks: ModuleInstance[] }`).
  data Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("template_region_contents")
}

model GlobalModule {
  id          String    @id @default(cuid())
  name        String
  values      Json
  // Anzeige-Einstellungen der einzelnen Modul-Instanz (z.B. Swiper-Effekt/
  // Autoplay/Navigation bei Galerien) – bewusst getrennt von `values`
  // (dem eigentlichen Inhalt), da diese Einstellungen nicht Teil des
  // ModuleType-Schemas sind, sondern pro Galerie individuell gesetzt
  // werden (siehe gallery-settings.ts). `null`/fehlende Keys fallen im
  // Frontend auf Defaults zurück.
  settings    Json?
  // Papierkorb, siehe Content.deletedAt – Galerien/FAQs teilen sich dieses
  // Modell (unterschieden nur über moduleType.slug), daher hier statt in
  // zwei getrennten Modellen.
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("GlobalModuleDeletedBy", fields: [deletedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  moduleTypeId String
  moduleType   ModuleType @relation(fields: [moduleTypeId], references: [id])

  @@map("global_modules")
}

model Content {
  id             String        @id @default(cuid())
  title          String
  slug           String
  status         ContentStatus @default(DRAFT)
  locale         String        @default("de")
  data           Json
  excerpt        String?
  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImageUrl     String?
  twitterCard    String?
  robotsIndex    Boolean       @default(true)
  robotsFollow   Boolean       @default(true)
  // Kategorien-Seite, Spalte "Aufmacher" (Nutzervorgabe, 2026-08-31, 1:1
  // nach Bildvorlage) – per Stern-Symbol umschaltbar, siehe
  // ContentService.toggleFeatured(). Rein redaktionelles Hervorheben
  // innerhalb einer Rubrik, keine Verbindung zu Status/Veröffentlichung.
  // Blendet die Überschrift der Seite auf der öffentlichen Website aus
  // (Nutzervorgabe, 2026-09-03). Gedacht für Seiten, die mit einem
  // randlosen Aufmacher beginnen und den Titel bereits im Bild tragen –
  // dort stünde die H1 darüber doppelt.
  //
  // Der Titel bleibt gesetzt und wird weiter gebraucht: für die Listen im
  // Backend, den Browser-Tab (<title>) und die Suchmaschinen. Ausgeblendet
  // wird ausschließlich die sichtbare Überschrift.
  hideTitle      Boolean       @default(false)
  isFeatured     Boolean       @default(false)
  scheduledFor   DateTime?
  publishedAt    DateTime?
  // Papierkorb (Nutzervorgabe, 2026-08-18, "überall da wo man löschen
  // kann") – Soft-Delete statt Hard-Delete. null = nicht gelöscht. Jede
  // Leseabfrage in ContentService (inkl. der beiden rohen SQL-Queries in
  // search()/searchCount()) muss deletedAt: null filtern, sonst tauchen
  // Papierkorb-Einträge wieder in normalen Listen auf.
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  contentTypeId String
  contentType   ContentType @relation(fields: [contentTypeId], references: [id])

  authorId String
  author   User   @relation("ContentAuthor", fields: [authorId], references: [id])

  lockedById String?
  lockedBy   User?     @relation("ContentLockedBy", fields: [lockedById], references: [id])
  lockedAt   DateTime?

  deletedById String?
  deletedBy   User?   @relation("ContentDeletedBy", fields: [deletedById], references: [id])

  versions        ContentVersion[]
  categories      ContentCategory[]
  tags            ContentTag[]
  previewTokens   ContentPreviewToken[]
  navigationItems NavigationItem[]

  @@unique([slug, locale])
  @@index([status])
  // Performance-Befund, 2026-08-25: `deletedAt: null` wird in praktisch
  // jeder Lese-Abfrage gefiltert (findAll/search/searchCount), `contentTypeId`
  // ist eine Fremdschlüsselspalte ohne automatischen Postgres-Index – beide
  // liefen bislang ohne Indexunterstützung.
  @@index([deletedAt])
  @@index([contentTypeId])
  @@map("contents")
}

model ContentPreviewToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@map("content_preview_tokens")
}

model ContentVersion {
  id        String                 @id @default(cuid())
  contentId String
  content   Content                @relation(fields: [contentId], references: [id], onDelete: Cascade)
  data      Json
  // Statusabbild von Content.status zum Zeitpunkt der Sicherung – für den
  // Status-Badge auf der neuen Versionen-Seite (Nutzervorgabe, 2026-08-30,
  // 1:1 nach Bildvorlage). Nullable statt eines Defaults: bereits
  // bestehende Versionen kennen ihren damaligen Status nicht rückwirkend
  // und sollen deshalb ehrlich keinen Badge zeigen statt eines erfundenen
  // "Entwurf" für jede Altzeile.
  status    ContentStatus?
  // Unterscheidet eine normale Bearbeitung von der automatischen
  // Sicherung, die rollback() unmittelbar vor dem Zurücksetzen anlegt
  // (siehe ContentService.rollback()) – es gibt in dieser App KEINEN
  // echten serverseitigen Autosave-Vorgang (das "Autosave" im Editor
  // schreibt nur lokal in localStorage, siehe content-editor-form.tsx),
  // ein "Automatisch"-Badge dafür wäre also erfunden. Gleiches
  // Nullable-Prinzip wie bei status.
  trigger   ContentVersionTrigger?
  createdAt DateTime               @default(now())

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@map("content_versions")
}

enum ContentVersionTrigger {
  EDIT
  ROLLBACK_BACKUP
}

model Category {
  id                String            @id @default(cuid())
  name              String            @unique
  slug              String            @unique
  description       String?
  // Kategorien hatten als einziges Taxonomie-Modell keine Zeitstempel
  // (Nutzervorgabe, 2026-09-03: "in Kategorie Erstellungsdatum
  // hinzufügen") – dadurch ließ sich die Liste weder nach Alter sortieren
  // noch überhaupt anzeigen, wann eine Kategorie angelegt wurde.
  // Bestehende Zeilen bekommen den Zeitpunkt der Migration, nicht ihren
  // echten Anlage-Zeitpunkt: der ist nirgends festgehalten und wäre nur
  // geraten.
  createdAt         DateTime          @default(now())
  // @default(now()) zusaetzlich zu @updatedAt: ohne Vorgabewert liesse
  // sich die Spalte nicht zu bestehenden Zeilen hinzufuegen.
  updatedAt         DateTime          @default(now()) @updatedAt
  // Kategorien-Seite, Kopfkachel/Sidebar-Balken (Nutzervorgabe,
  // 2026-08-31: "nutze den gleichen color picker wie in einstellungen
  // und darstellung") – Hex-Wert wie `AppSettings.accentColor`, nicht
  // die vorher rein dekorative Hash-Farbe (siehe tag-colors.ts). `null`
  // = noch keine eigene Farbe gewählt, Sidebar/Balken fallen dann auf
  // die bisherige Hash-Farbe zurück statt einen erfundenen Standard
  // vorzuspiegeln.
  color             String?
  // Kategorien-Seite, Kachel "Archiv & Feed" (Nutzervorgabe, 2026-08-31:
  // "wir bauen eine öffentliche Webseite. Master und Client haben immer
  // eine öffentliche Webseite ... das folgt in einem weiteren Schritt")
  // – echte, persistierte Einstellungen für die noch zu bauende
  // öffentliche Website ("Frontend" in Nutzer-Terminologie, nicht zu
  // verwechseln mit apps/web, das der Nutzer "Backend"/Administration
  // nennt). `showFeaturedLarge` steuert die Aufmacher-Kachel im
  // Kategorie-Archiv (siehe PublicContentService.getCategory()).
  //
  // `archivePublished` ist am 2026-09-02 entfallen: seit die
  // Übersichtsseite genau dann öffentlich ist, wenn ein Menüpunkt auf sie
  // zeigt, war der Schalter eine zweite Stelle für dieselbe Aussage und
  // wurde nirgends mehr ausgewertet (Nutzerentscheidung: "die zusätzliche
  // einstellung in der kategorie wird nicht gebraucht").
  rssEnabled        Boolean           @default(false)
  showFeaturedLarge Boolean           @default(false)
  // Sortierung/Seitengröße wirken auf die eigene Beiträge-Tabelle dieser
  // Kategorie im Dashboard (Nutzerentscheidung nach Rückfrage – im
  // Mockup ursprünglich für die nicht existierende Archivseite gedacht).
  // MANUAL ist als Wert wählbar/speicherbar, aber mangels eines
  // Reihenfolge-Felds auf `ContentCategory` noch nicht wirksam umgesetzt
  // – fällt bis dahin auf NEWEST zurück (siehe ContentService.findAll()).
  sortOrder         CategorySortOrder @default(NEWEST)
  postsPerPage      Int?
  // Papierkorb, siehe Content.deletedAt.
  deletedAt         DateTime?
  deletedById       String?
  deletedBy         User?             @relation("CategoryDeletedBy", fields: [deletedById], references: [id])
  contents          ContentCategory[]
  // Menüpunkte, die auf das Archiv dieser Kategorie zeigen (seit
  // 2026-09-02, siehe NavigationItem.categoryId).
  navigationItems   NavigationItem[]

  @@map("categories")
}

model ContentCategory {
  contentId  String
  categoryId String
  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([contentId, categoryId])
  @@map("content_categories")
}

model Tag {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  // Papierkorb, siehe Content.deletedAt.
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?        @relation("TagDeletedBy", fields: [deletedById], references: [id])
  createdAt   DateTime     @default(now())
  contents    ContentTag[]
  media       MediaTag[]

  @@map("tags")
}

model ContentTag {
  contentId String
  tagId     String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentId, tagId])
  @@map("content_tags")
}

// ---------- Navigation ----------

model Navigation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items                       NavigationItem[]
  // Rückbezüge für die drei AppSettings-Verweise (Hauptmenü + zwei
  // Footer-Spalten) – rein strukturell für Prisma, keine eigene
  // Verwendung nötig. Listen statt Einzelwerten, seit das `@unique`
  // drüben gefallen ist (siehe dortiger Kommentar).
  mainNavigationOf            AppSettings[]    @relation("MainNavigation")
  footerNavigationPrimaryOf   AppSettings[]    @relation("FooterNavigationPrimary")
  footerNavigationSecondaryOf AppSettings[]    @relation("FooterNavigationSecondary")

  @@map("navigations")
}

model NavigationItem {
  id           String   @id @default(cuid())
  label        String
  externalUrl  String?
  // Gilt für Inhalts- UND externe Ziele gleichermaßen (Nutzervorgabe,
  // 2026-08-21: "bei jedem menüpunkt") – nicht nur für externe Links, da
  // auch ein interner Inhalt in einem neuen Tab geöffnet werden können
  // soll.
  openInNewTab Boolean  @default(false)
  // Genau EIN Navigationspunkt app-weit darf die Startseite sein
  // (Nutzervorgabe, 2026-08-31: "nur einmal vergeben werden dürfen" –
  // beim Setzen wird der bisherige automatisch abgewählt, siehe
  // NavigationService.updateItem()). Bewusst keine DB-Unique-Regel:
  // "höchstens ein true" ist als partieller Index in Prisma nicht
  // ausdrückbar, die Exklusivität setzt der Service in einer Transaktion
  // durch.
  isHomepage   Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  navigationId String
  navigation   Navigation @relation(fields: [navigationId], references: [id], onDelete: Cascade)

  // Ziel entweder ein Inhalt ODER eine externe URL (App-Ebene validiert,
  // dass genau eines von beidem gesetzt ist – siehe NavigationService).
  contentId String?
  content   Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  // Drittes mögliches Ziel neben Inhalt und externer URL (Nutzervorgabe,
  // 2026-09-02: "kategorie soll in menü auswählbar sein ... das
  // funktioniert dann wie ein blog"). Zeigt auf die Archivseite der
  // Kategorie (`/{category.slug}`), die alle veröffentlichten Beiträge
  // dieser Kategorie untereinander auflistet.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Darstellung der Archivseite. Bewusst hier und NICHT an `Category`
  // (Nutzerentscheidung, 2026-09-02, nach Rückfrage): dieselbe Kategorie
  // darf in zwei Menüs unterschiedlich aussehen. Nur relevant, wenn
  // `categoryId` gesetzt ist; bei den anderen Zielarten steht der
  // Default und wird ignoriert.
  //
  // Folge dieser Wahl: die öffentliche URL ist nur `/{slug}` und kennt den
  // Menüpunkt nicht – welche Darstellung greift, löst
  // `PublicContentService.getCategory()` über den Menüpunkt auf, der auf
  // die Kategorie zeigt (Hauptmenü zuerst, siehe dort).
  categoryLayout CategoryArchiveLayout @default(LIST)

  // Wie der Punkt im Header der Website aussieht (Nutzerentscheidung,
  // 2026-09-02). Damit sind Handlungsaufrufe wie "Anmelden" und "Demo
  // buchen" ganz normale Menüpunkte, die sich umbenennen, umhängen oder
  // entfernen lassen – statt zweier fest verdrahteter Knöpfe im Code.
  // Im Footer ohne Wirkung: dort sind alle Punkte Links.
  appearance NavigationItemAppearance @default(LINK)

  // Außenabstand der Seite, auf die dieser Menüpunkt zeigt, in Pixeln
  // (Nutzervorgabe, 2026-09-03) – für JEDEN Menüpunkt, unabhängig vom
  // gewählten Ziel: sowohl eine Seite als auch eine Kategorie-
  // Übersichtsseite beginnt sonst bündig unter der Kopfzeile.
  //
  // Am MENÜPUNKT und nicht am Inhalt, aus demselben Grund wie
  // `categoryLayout`: dasselbe Ziel darf an zwei Stellen im Menü
  // unterschiedlich aussehen.
  //
  // Getrennt nach Breakpoint (Nutzervorgabe: "mobile und desktop", dann
  // "bau noch tablet ein"): `…Mobile` ist der Grundwert, `…Tablet` greift
  // ab 768px, `…Desktop` ab 1024px. Ohne eigenen Wert erbt jede Stufe die
  // nächstkleinere – Desktop also vom Tablet, Tablet vom Mobilwert.
  //
  // `null` = kein eigener Wert, dann bleibt der Abstand des Templates –
  // das ist etwas anderes als 0 (bündig). Bewusst nur oben und unten:
  // links und rechts bestimmt die Inhaltsbahn.
  marginTopMobile     Int?
  marginBottomMobile  Int?
  marginTopTablet     Int?
  marginBottomTablet  Int?
  marginTopDesktop    Int?
  marginBottomDesktop Int?

  parentId String?
  parent   NavigationItem?  @relation("NavigationItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children NavigationItem[] @relation("NavigationItemHierarchy")

  @@index([navigationId])
  @@index([parentId])
  @@index([categoryId])
  @@map("navigation_items")
}

/**
 * Darstellung einer Kategorie-Archivseite auf der öffentlichen Website
 * (Nutzervorgabe, 2026-09-02). Beide Varianten blättern über
 * `Category.postsPerPage`.
 * - `LIST`: kompakt, nur Titel + Datum je Beitrag.
 * - `BLOCKS`: Karte je Beitrag mit Titelbild (`Content.ogImageUrl`),
 * Titel, Datum und Anreißtext (`Content.excerpt`).
 */
enum CategoryArchiveLayout {
  LIST
  BLOCKS
}

/**
 * Darstellung eines Menüpunkts im Header der öffentlichen Website
 * (Nutzerentscheidung, 2026-09-02).
 * - `LINK`: gewöhnlicher Menüpunkt.
 * - `TEXT_BUTTON`: rechts abgesetzt, kräftiger, ohne Fläche ("Anmelden").
 * - `ACCENT_BUTTON`: rechts abgesetzt, gefüllte Akzentfläche ("Demo
 * buchen"). Mehrere Punkte dürfen dieselbe Darstellung haben.
 */
enum NavigationItemAppearance {
  LINK
  TEXT_BUTTON
  ACCENT_BUTTON
}

// ---------- Medien ----------

model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  isSystem  Boolean       @default(false)
  parent    MediaFolder?  @relation("MediaFolderChildren", fields: [parentId], references: [id])
  children  MediaFolder[] @relation("MediaFolderChildren")
  media     Media[]
  createdAt DateTime      @default(now())

  @@map("media_folders")
}

model Media {
  id           String    @id @default(cuid())
  filename     String
  url          String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          String?
  focalX       Float?
  focalY       Float?
  thumbnailUrl String?
  // Papierkorb, siehe Content.deletedAt. Anders als bei Content löscht
  // remove() aktuell auch die physische Datei von Disk – das ändert sich:
  // Soft-Delete lässt die Datei liegen, erst permanentDelete() löscht sie
  // wirklich (siehe MediaService).
  deletedAt    DateTime?
  deletedById  String?
  deletedBy    User?     @relation("MediaDeletedBy", fields: [deletedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  uploadedById String
  uploadedBy   User   @relation("MediaUploadedBy", fields: [uploadedById], references: [id])

  folderId String?
  folder   MediaFolder? @relation(fields: [folderId], references: [id])

  variants MediaVariant[]
  tags     MediaTag[]

  dataProcessorContracts DataProcessor[]
  sccTemplateForSettings AppSettings[]

  @@map("media")
}

model MediaVariant {
  id        String   @id @default(cuid())
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  width     Int
  format    String
  url       String
  size      Int
  createdAt DateTime @default(now())

  @@unique([mediaId, width, format])
  @@map("media_variants")
}

model MediaTag {
  mediaId String
  tagId   String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  tag     Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mediaId, tagId])
  @@map("media_tags")
}

// ---------- Audit Log ----------

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ---------- Webhooks ----------

model Webhook {
  id                  String    @id @default(cuid())
  url                 String
  events              String[]
  isActive            Boolean   @default(true)
  lastDeliveryStatus  String?
  lastDeliveryAt      DateTime?
  lastDeliveryError   String?
  consecutiveFailures Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("webhooks")
}

// ---------- Master/Slave-Lizenzsystem ----------
// Nutzervorgabe, 2026-08-24: diese Codebase kann sowohl als "Master"
// (verwaltet alle ausgelieferten Installationen, dieses Modell) als auch
// als "Slave" (eine ausgelieferte Installation, prüft wöchentlich per Pull
// bei ihrem Master) laufen (`DEPLOYMENT_MODE`-Umgebungsschalter). Voller
// Plan inkl. Token-Design und Sicherheitsüberlegungen:
// knowledge-base/platform/master-slave-licensing.md.

// Mandantenfähigkeit (Nutzervorgabe, 2026-08-27): "bei den Mandanten
// gehört immer eine Webseite oder mehrere dazu" – ein Mandant ist der
// eigentliche Kunde des Masters und kann mehrere Website-Installationen
// haben (z.B. mehrere Marken/Domains desselben Kunden). Modul-Buchung
// (siehe `MandantModule`) liegt bewusst HIER, nicht pro Website – ein
// gebuchtes Modul gilt für den ganzen Mandanten und damit für alle seine
// Websites gleichermaßen.
model Mandant {
  id   String @id @default(cuid())
  name String

  // Mitgliedschafts-Status (Master-seitige Verwaltung, unabhängig vom
  // technischen `Website.status` live/development/locked einzelner
  // Installationen): "active" | "inactive" | "locked".
  status String @default("active")

  // Freitext-Begründung einer Sperre (Nutzervorgabe, 2026-08-27: "wenn
  // gesperrt, dann Sperrvermerk" – z.B. "Beitrag für Q3/2026 offen").
  // Nur bei status="locked" im UI abgefragt/angezeigt, bleibt aber auch
  // danach erhalten (Historie), falls später wieder entsperrt wird.
  lockReason String?

  // Logo dieses Mandanten (Nutzervorgabe, 2026-08-27: "bau ein Logo
  // Upload bei Mandanten ein") – eigenes Feld statt Wiederverwendung von
  // `AppSettings.companyLogoUrl`, da das Firmenlogo dort IMMER Pivots
  // eigenes ist, nicht das eines Kunden. Relative Medien-URL wie bei
  // `companyLogoUrl`, gleicher `mediaUrl()`/`resolveImageSrc()`-Helfer.
  logoUrl String?

  // Firmenangaben (Nutzervorgabe, 2026-08-27: "speisen Impressum,
  // Datenschutzhinweise und Systemmails dieses Mandanten") – Master-
  // seitige Referenzdaten zu diesem Kunden. Alle optional, da beim
  // Anlegen eines Mandanten noch nichts davon zwingend bekannt ist.
  legalName          String?
  representativeName String?
  street             String?
  postalCode         String?
  city               String?
  country            String?
  email              String?
  phone              String?
  registerInfo       String?
  vatId              String?

  websites Website[]
  modules  MandantModule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mandanten")
}

model Website {
  id     String @id @default(cuid())
  name   String
  domain String @unique

  // Mandantenfähigkeit, 2026-08-27: jede Website gehört zu genau einem
  // Mandanten – "Projekt anlegen" gibt es deshalb nicht mehr direkt auf
  // der Webseite-Seite, sondern nur noch über den jeweiligen Mandanten.
  mandantId String
  mandant   Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)

  // "live" | "development" | "locked" – "development" ist von der
  // Lizenzprüfung komplett ausgenommen (siehe Slave-seitige Durchsetzung,
  // noch nicht implementiert), "locked" löst auf der Slave-Installation
  // den Wartungsmodus aus.
  status String @default("development")

  // AES-256-GCM-verschlüsselter Site-API-Key (Pull-Authentifizierung durch
  // die Slave-Installation an `POST /license/check`) – Nutzervorgabe,
  // 2026-08-24: "ich will mir den Key immer mit Icon anzeigen lassen",
  // daher bewusst umkehrbar verschlüsselt statt gehasht (wie zuvor).
  // Bekannter Trade-off (siehe knowledge-base/platform/
  // master-slave-licensing.md): ein DB-Leak legt damit nutzbare Keys für
  // alle Websites offen, nicht nur für neu angelegte. Gleicher
  // Verschlüsselungs-Helfer wie beim SMTP-Passwort
  // (common/utils/secret-encryption.ts). `null` bei Installationen, deren
  // Key vor dieser Spalte angelegt wurde (erst beim nächsten
  // "Neu erzeugen" befüllt).
  apiKeyEncrypted String?

  // "master" | "slave" – rein informativ/dokumentarisch (Nutzervorgabe,
  // 2026-08-24: Einstellungen → Master-Client soll für JEDE Zeile,
  // einschließlich Mandanten, ein einfaches Master/Client-Popup anbieten).
  // Hat KEINE technische Wirkung: der Master hat keinen Push-Mechanismus,
  // um den tatsächlichen Modus einer entfernten Installation zu setzen –
  // jede Installation stellt ihren echten Modus ausschließlich über ihr
  // eigenes `AppSettings.deploymentMode` vor Ort ein.
  deploymentMode String @default("slave")

  // Monoton steigender Zähler, in jedes ausgestellte Token eingebettet –
  // verhindert, dass eine Slave-Installation ein altes, noch nicht
  // abgelaufenes Token (z.B. aus einem Backup) wiederherstellt, um eine
  // später ausgesprochene Sperre zu umgehen.
  lastSeq       Int       @default(0)
  lastCheckInAt DateTime?

  // Master-seitige Live-Überwachung (WebsiteMonitorService, Nutzervorgabe
  // 2026-08-24): regelmäßiger, echter HTTP-Aufruf gegen `https://domain/`
  // für Websites mit status="locked" – bleibt die Seite trotz Sperre
  // erreichbar (ohne Wartungsseiten-Kennzeichnung), ist das eine Anomalie
  // und löst eine Benachrichtigung für den Pivot-Admin aus.
  lastLiveCheckAt      DateTime?
  lastLiveCheckAnomaly Boolean   @default(false)

  // Ergebnis des letzten "Wecken"-Diagnose-Durchlaufs über ALLE Websites
  // (Nutzervorgabe, 2026-08-24: "wenn ich bei Pivot Master prüfe, sollen
  // alle Webseiten einmal durchlaufen werden und den Status ausgeben, der
  // gerade ist, z.B. ob der Key korrekt ist") – anders als der reine
  // Live-Check oben (der nur gesperrte Websites betrifft und nichts über
  // Key/Modus aussagt) weckt dieser Durchlauf JEDE Installation, die dabei
  // ihren eigenen, echten `performCheck()` ausführt; `lastWakeupOk`/
  // `lastWakeupMessage` spiegeln dessen tatsächliches Ergebnis (nicht nur
  // "Aufruf angekommen"). `lastWakeupAt` macht die Kachel-Anzeige explizit
  // als Momentaufnahme kenntlich statt einen dauerhaft aktuellen Live-
  // Status vorzutäuschen.
  statsReports WebsiteStatsReport[]

  lastWakeupAt      DateTime?
  lastWakeupOk      Boolean?
  lastWakeupMessage String?

  // Von der Installation beim "Prüfen"/"Wecken" selbst gemeldete Größe
  // (Nutzervorgabe, 2026-09-01: "kann ich die nutzerzahl abrufen über
  // prüfen? so dass ich diese in den webseite kacheln angezeigt bekomme").
  // Kommt denselben Weg wie `lastReportedVersion`: der Master ruft
  // `/api/license/wakeup` der Installation auf, die antwortet mit ihren
  // eigenen Zählwerten. Damit sind es SELBSTAUSKÜNFTE der Slave-Seite –
  // gut genug für eine Übersichtsanzeige, aber bewusst keine
  // manipulationssichere Grundlage für Abrechnung o.ä. (der Master hat
  // weiterhin keinen Zugriff auf die Client-Datenbank). `null`, solange
  // nie erfolgreich geprüft wurde; ein fehlgeschlagener Lauf lässt den
  // letzten bekannten Stand stehen, statt ihn auf "unbekannt"
  // zurückzusetzen.
  reportedPageCount Int?
  reportedUserCount Int?

  // Plausibilitätsprüfung der oben gemeldeten Selbstauskünfte
  // (Nutzervorgabe, 2026-09-01, nach der Frage "ist das jetzt sicher vor
  // manipulation?" – Antwort: nein, die Zahl bestimmt die Client-Seite
  // selbst; das hier ERKENNT grobe Manipulation, verhindert sie nicht).
  // Gesetzt, wenn ein gemeldeter Wert gegenüber dem vorherigen Bericht
  // unglaubwürdig einbricht; bleibt danach stehen, bis jemand ihn am
  // Master quittiert – sonst wäre ein einmaliger Sprung beim nächsten
  // Prüfen wieder unsichtbar (der neue Wert ist dann ja stabil).
  statsAnomalyAt      DateTime?
  statsAnomalyMessage String?

  // Nutzervorgabe, 2026-08-25: "Entwicklermodus wird nach spätestens 3
  // Tagen automatisch gesperrt, bis zur Reaktivierung" – Zeitpunkt, seit
  // dem `status` ununterbrochen "development" ist. Nur bei einem echten
  // Wechsel IN den Entwicklungsmodus gesetzt (siehe WebsitesService.
  // update()), nicht bei jeder beliebigen Feldänderung – sonst würde ein
  // Wecken/Prüfen die Frist versehentlich immer wieder zurücksetzen.
  // `null`, sobald der Status wieder verlässt. Siehe
  // WebsitesService.autoLockStaleDevelopmentSites().
  developmentModeSince DateTime?

  // Von der Installation selbst gemeldete Version (Semver+Commit-Hash,
  // siehe common/utils/app-version.ts), zuletzt beim "Wecken"/"Prüfen"
  // eingeholt (Nutzervorgabe, 2026-08-25: "damit man den aktuellen Stand
  // ermitteln kann"). Rein informativ, keine Auswirkung auf den Status.
  lastReportedVersion String?

  // Vom Client zuletzt selbst bestätigter Lizenzstatus (Nutzervorgabe,
  // 2026-08-25: "hier die entsprechenden Badges nehmen" im Prüfdetails-
  // Popup) – nur gesetzt, wenn die Prüfung wirklich erfolgreich war, sonst
  // bleibt der zuletzt bekannte Stand erhalten (gleiches Prinzip wie
  // `lastReportedVersion`).
  lastReportedLicenseStatus String?

  // Einzelne Teilergebnisse des letzten "Wecken"-Durchlaufs (Nutzervorgabe,
  // 2026-08-25: "schreibe alle Prüfungen untereinander, die OK sind mit
  // Haken, die nicht OK mit X") – JSON-Array `{label, ok}[]`, siehe
  // WebsitesService.performWakeup(). Nicht anwendbare Checks (z.B.
  // Versionsvergleich ohne gemeldete Version) fehlen einfach im Array,
  // statt geraten zu werden.
  lastCheckChecks Json?

  // Überschreibt `https://{domain}/` als Ziel für den obigen Live-Check
  // (Nutzervorgabe, 2026-08-24: "ich will auch das lokale Testen hier drin
  // haben") – nur für lokale/Test-Installationen relevant, deren Domain
  // nicht wirklich auf sie zeigt (z.B. `http://localhost:3010` für strasev
  // während der lokalen Entwicklung). Bei echten Kunden-Installationen
  // leer lassen, dann bleibt `https://{domain}/` maßgeblich.
  testUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Performance-Selbstbefund, 2026-08-25: von autoLockStaleDevelopmentSites()
  // gefiltert – bei der aktuellen/realistischen Tabellengröße (Anzahl
  // Kundeninstallationen) irrelevant, aber kostenlos nachgerüstet.
  @@index([status])
  @@index([mandantId])
  @@map("websites")
}

// Verlauf der von einer Installation gemeldeten Kennzahlen (Nutzervorgabe,
// 2026-09-01: "Verlauf der gemeldeten Zahlen speichern und bei
// unglaubwürdigen Sprüngen eine Systemnachricht auslösen"). Dient zwei
// Zwecken: Vergleichsbasis für die Plausibilitätsprüfung und
// Nachvollziehbarkeit einer ausgelösten Meldung ("von 24 auf 3 am …").
// Bewusst eine eigene Tabelle statt zweier "vorher"-Spalten an Website:
// bei einer Manipulation ist der Verlauf davor die eigentlich
// interessante Information.
//
// **Eine Zeile je ÄNDERUNG, nicht je Prüfung** (Nutzervorgabe,
// 2026-09-01: "unnötigen Datenmüll vermeiden"): meldet eine Installation
// dieselben Zahlen wie beim letzten Mal, wird nur `lastReportedAt` des
// bestehenden Eintrags hochgesetzt. Eine stabile Installation, die
// hundertmal geprüft wird, hat damit genau eine Zeile – und der Verlauf
// liest sich als Liste echter Sprünge statt als Klick-Protokoll.
// `firstReportedAt`/`lastReportedAt` sagen zusammen "dieser Stand galt
// von … bis …". Zusätzlich auf die letzten 50 Einträge je Website
// beschnitten (siehe WebsitesService).
model WebsiteStatsReport {
  id        String  @id @default(cuid())
  websiteId String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  pageCount Int
  userCount Int

  firstReportedAt DateTime @default(now())
  lastReportedAt  DateTime @default(now())

  @@index([websiteId, firstReportedAt])
  @@map("website_stats_reports")
}

// Mandantenfähigkeit (Nutzervorgabe, 2026-08-27): welche Module ein
// Mandant gebucht hat – gilt für ALLE seine Websites gleichermaßen (siehe
// Kommentar bei `Mandant`). Der Modul-KATALOG selbst bleibt Code
// (`websites/module-catalog.ts`, kein "Neu"-Button) – diese Tabelle hält
// ausschließlich die Ja/Nein-Buchung, keine modulspezifische
// Konfiguration (z.B. Zugangsdaten für ein Modul trägt der Kunde lokal in
// seiner eigenen Installation ein, siehe Knowledge-Base).
model MandantModule {
  id         String   @id @default(cuid())
  mandantId  String
  mandant    Mandant  @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  moduleKey  String
  bookedAt   DateTime @default(now())
  bookedById String?

  // Nutzervorgabe, 2026-08-27: "Module ... hinzugefügt, dann aktivierbar
  // und deaktivierbar mit Schieberegler" – Hinzufügen (diese Zeile
  // existiert) und Aktivsein sind zwei getrennte Zustände. Nur aktive
  // Module gehen in den signierten Lizenz-Token ein (siehe
  // `WebsitesService.checkLicense()`), ein hinzugefügtes, aber
  // deaktiviertes Modul schaltet clientseitig nichts frei.
  enabled Boolean @default(true)

  // Datenschutz-als-Modul (Nutzervorgabe, 2026-08-28): manche Module
  // gliedern sich in Unter-Features (bei Datenschutz: die 7 Reiter der
  // Seite, siehe `websites/module-catalog.ts` `ModuleCatalogEntry.features`).
  // Hinzufügen/Aktivsein des ganzen Moduls (oben) und welche einzelnen
  // Unter-Features aktiv sind, sind zwei getrennte Ebenen – ein
  // deaktiviertes Feature schaltet nur diesen einen Reiter clientseitig
  // ab, nicht das ganze Modul. Startet beim Hinzufügen mit ALLEN
  // Feature-Keys des Katalog-Eintrags befüllt (frisch gebucht = komplett
  // aktiv).
  enabledFeatures String[] @default([])

  @@unique([mandantId, moduleKey])
  @@map("mandant_modules")
}

// Datenschutz-als-Modul (Nutzervorgabe, 2026-08-28): Masters EIGENE
// Modul-/Feature-Freischaltung – Master hat kein `Mandant`-Objekt für sich
// selbst ("Master wird nicht über Mandanten geregelt"), braucht aber
// dieselbe Freischaltungs-Logik wie ein Client, damit `ModuleEntitlementGuard`/
// `ModuleFeatureGuard` beide Installationstypen einheitlich prüfen können
// (siehe `LicenseClientService.getEffectiveStatus()`). Editierbar unter
// Einstellungen → Module (nur auf einer Master-Installation sichtbar).
model ModuleSettings {
  moduleKey String @id

  enabled         Boolean  @default(true)
  enabledFeatures String[] @default([])

  // Wenn aktiv, bucht `MandantenService.create()` dieses Modul automatisch
  // für jeden neu angelegten Mandanten mit.
  autoInstallForNewMandants Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@map("module_settings")
}

// Slave-lokaler Zustand des zuletzt erfolgreich abgerufenen Lizenz-Tokens
// (siehe LicenseClientService) – nur relevant bei `DEPLOYMENT_MODE=slave`.
// Immer genau eine Zeile (fixe `id`), da eine Installation nur einen
// eigenen Lizenzstatus hat. Getrennt vom rohen Token-Format (siehe
// license-token.util.ts) für schnelle Abfragen ohne erneute
// Signaturprüfung bei jedem Request.
model LicenseState {
  id String @id @default("singleton")

  // Rohes, signiertes Token vom letzten erfolgreichen Abruf – für eine
  // erneute Signaturprüfung bei Bedarf aufbewahrt, nicht nur die
  // entpackten Felder unten.
  token     String?
  status    String? // "live" | "development" | "locked"
  domain    String?
  expiresAt DateTime?
  seq       Int       @default(0)

  // Letzter ERFOLGREICHER Abruf vs. letzter VERSUCH (auch fehlgeschlagene)
  // – die Differenz steuert die Karenzzeit-Logik (14 Tage Token-Laufzeit +
  // 7 Tage Karenz nach Ablauf, siehe knowledge-base/platform/
  // master-slave-licensing.md).
  lastCheckInAt      DateTime?
  lastCheckAttemptAt DateTime?

  // Vom Master signalisiert (siehe LicenseTokenPayload.developmentModeSince)
  // – seit wann diese Installation ununterbrochen im Entwicklungsmodus
  // läuft, für die "wird automatisch gesperrt am ..."-Anzeige im Toast
  // (Nutzervorgabe, 2026-08-25). `null`, wenn `status` nicht "development"
  // ist oder der Master (noch) keine Version mit diesem Feld ausliefert.
  developmentModeSince DateTime?

  // Schutz gegen Zeitmanipulation: höchster bisher beobachteter
  // Zeitpunkt. Springt die Systemzeit spürbar zurück, darf das nicht
  // automatisch mehr Vertrauen in ein sonst abgelaufenes Token schaffen
  // (siehe "Sicherheits-Realitätscheck" in der Knowledge-Base).
  lastObservedAt DateTime?

  // Mandantenfähigkeit (Nutzervorgabe, 2026-08-27): die zuletzt vom Master
  // signiert bestätigten, gebuchten Modul-Keys dieser Installation (siehe
  // LicenseTokenPayload.modules) – einzige Quelle, aus der eine
  // Client-Installation ihre eigenen Modul-Entitlements kennt.
  modules String[] @default([])

  // Datenschutz-als-Modul (Nutzervorgabe, 2026-08-28): welche Unter-
  // Features je gebuchtem Modul aktiv sind (Record<moduleKey, string[]>,
  // z.B. `{"datenschutz": ["rechtstexte","vorfaelle"]}`) – JSON statt
  // eines eigenen Feldes pro Modul, da die Anzahl/Namen der Module offen
  // ist. Kommt aus `LicenseTokenPayload.modules[].features`.
  moduleFeatures Json @default("{}")

  updatedAt DateTime @updatedAt

  @@map("license_state")
}

// ---------- Formulare & Mailing ----------
// Nutzervorgabe, 2026-08-23: "formulare als punkt links in der sidebar
// bei inhalte ... unter mailing möchte ich die dazugehörenden
// mailvorlagen ... das soll so kombiniert werden, das ich in den
// formularen die entsprechende vorlage auswählen kann". Bewusst ein
// eigenes, dediziertes Datenmodell statt Wiederverwendung von
// GlobalModule/ModuleType (Basis von Galerie/FAQ) – dieses generische
// System wurde für stark strukturierte, repeater-lastige Inhalte
// bereits einmal verworfen (siehe knowledge-base/content/
// faq-and-gallery-dedicated-pages.md) und kennt ohnehin kein
// "viele Einsendungen zu einer Definition"-Konzept (nur 1 `values`-Json
// pro Instanz, keine Kind-Tabelle).
model Form {
  id                String  @id @default(cuid())
  name              String
  slug              String  @unique
  // draft | published | paused – Sidebar-Filterpills, Status-Badge.
  status            String  @default("draft")
  // [{ id, type, label, required, width, options? }] – `id` ist die
  // stabile Feld-ID (= Platzhalter-Name in den Mail-Vorlagen dieses
  // Formulars, z.B. {{name}}). `type` ∈ text/textarea/email/tel/number
  // (Basis), select/radio/checkbox (Auswahl, mit `options`), date/file
  // (Erweitert – "file" nur strukturell vorgesehen, kein Upload-Handling
  // in dieser Ausbaustufe).
  fields            Json
  // Welche Feld-`id` die Ziel-Adresse der Bestätigungsmail liefert;
  // null = kein E-Mail-Feld vorhanden, Bestätigung technisch nicht
  // möglich (siehe `sendConfirmation`).
  emailFieldId      String?
  sendConfirmation  Boolean @default(false)
  // Absenden-Button des öffentlichen Formulars (form-block-render.tsx).
  submitButtonText  String  @default("Absenden")
  submitButtonAlign String  @default("left") // left | center | right
  // Optionale Weiterleitung nach erfolgreichem Absenden statt der
  // eingebauten "Vielen Dank"-Meldung – leer = Standardmeldung bleibt.
  redirectUrl       String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("FormDeletedBy", fields: [deletedById], references: [id])

  submissions   FormSubmission[]
  mailTemplates MailTemplate[]

  @@map("forms")
}

model FormSubmission {
  id          String    @id @default(cuid())
  formId      String
  form        Form      @relation(fields: [formId], references: [id], onDelete: Cascade)
  values      Json
  // Nur befüllt, wenn AppSettings.dsbFormStoreSubmissionIp aktiv ist –
  // aktiviert erstmals diese bisher wirkungslose Datenschutz-Einstellung
  // (siehe privacy-view.tsx, dort bislang als "vorgehalten, nicht
  // funktional" dokumentiert).
  submitterIp String?
  // Basis für den "unbearbeitet"-Zähler in der Formulare-Übersicht,
  // gleiches Prinzip wie Notification.isRead.
  isRead      Boolean   @default(false)
  // Zeitpunkt des Lesens – Bezugspunkt für die automatische Löschung
  // (AppSettings.formSubmissionDeleteAfterReadDays, Nutzervorgabe
  // 2026-09-02). `isRead` allein reichte dafür nicht: es sagt DASS,
  // nicht WANN. Wird beim Markieren gesetzt und beim Zurücksetzen auf
  // ungelesen wieder geleert, damit die Frist neu beginnt.
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([formId, createdAt])
  @@map("form_submissions")
}

// Eine gemeinsame Tabelle für ALLE Mail-Vorlagen dieser App – die 11
// bestehenden System-Mail-Auslöser (Verifikation, Passwort-Reset,
// DSB-Mails, ...) UND die beiden formulargebundenen Vorlagen
// (Admin-Benachrichtigung/Bestätigung) landen bewusst in derselben
// Tabelle/Liste (Nutzervorgabe: unter Mailing zusammen bearbeitbar).
// `key` = fester, im Code vergebener Schlüssel für System-Mails (z.B.
// "auth.verify-email"), `formId`+`formKind` = für formulargebundene
// Vorlagen. Genau eine der beiden Zuordnungen ist pro Zeile gesetzt.
model MailTemplate {
  id          String     @id @default(cuid())
  key         String?    @unique
  formId      String?
  form        Form?      @relation(fields: [formId], references: [id], onDelete: Cascade)
  formKind    String? // "admin_notification" | "confirmation"
  subject     String
  body        String
  // Welche Hülle beim Versand verwendet wird (Nutzervorgabe, 2026-08-30:
  // "bei allen Vorlagen soll man das Template aussuchen können") – `null`
  // fällt auf die Standard-Hülle der Installation zurück. Gilt für JEDE
  // Vorlage (System, Formular), nicht mehr nur für individuelle – die
  // individuellen ("kind: custom") Vorlagen selbst wurden entfernt
  // (2026-08-30-Korrektur: kein echter Auslöser dafür vorhanden, siehe
  // knowledge-base/content/forms.md).
  shellId     String?
  shell       MailShell? @relation(fields: [shellId], references: [id], onDelete: SetNull)
  // "Versand aktiv"-Schalter pro Vorlage – gleiches Prinzip wie
  // ScheduledJob.isPaused: deaktiviert überspringt den Versand beim
  // nächsten Auslöser, statt etwas zu löschen.
  enabled     Boolean    @default(true)
  // Nur bei admin-gerichteten Mails mit editierbarem Empfänger gesetzt
  // (z.B. Formular-Admin-Benachrichtigung). System-Mails mit
  // kontextabhängigem Empfänger (Passwort-Reset geht an den
  // anfragenden Nutzer, DSB-Mails an den DSB-Kontakt, ...) lassen das
  // bewusst leer – kein editierbares Empfänger-Feld in der UI dafür.
  recipientTo String?
  updatedAt   DateTime   @updatedAt

  @@unique([formId, formKind])
  @@map("mail_templates")
}

// Nutzervorgabe, 2026-08-30: "mache mehrere Hüllen für eine Installation
// möglich" – der äußere Rahmen (Kopf/Fuß/CI) individueller HTML-Mails,
// getrennt vom eigentlichen Vorlagen-Inhalt. Mehrere pro Installation,
// genau eine davon `isDefault`. `content` enthält als normalen Text den
// Platzhalter `{{content}}` (gleiches `{{...}}`-Muster wie überall sonst
// im Mailing, siehe MailerService.renderPlaceholders) – dort wird beim
// Versand der gerenderte Vorlagen-Inhalt eingesetzt.
model MailShell {
  id        String         @id @default(cuid())
  name      String
  content   String
  isDefault Boolean        @default(false)
  updatedAt DateTime       @updatedAt
  templates MailTemplate[]

  @@map("mail_shells")
}
