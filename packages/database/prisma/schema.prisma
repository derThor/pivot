generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth & Benutzer ----------

model Role {
  id                 String   @id @default(cuid())
  name               String   @unique
  description        String?
  isSystem           Boolean  @default(false)
  isDefault          Boolean  @default(false)
  canAccessDashboard Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id       String @id @default(cuid())
  resource String
  action   String

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AppSettings {
  id                         Int      @id @default(1)
  allowRegistration          Boolean  @default(true)
  allowPasswordReset         Boolean  @default(true)
  allowEmailChange           Boolean  @default(true)
  requireAdminActivation     Boolean  @default(false)
  autosaveEnabled            Boolean  @default(true)
  passwordMinLength          Int      @default(8)
  passwordRequireUppercase   Boolean  @default(true)
  passwordRequireLowercase   Boolean  @default(true)
  passwordRequireNumber      Boolean  @default(true)
  passwordRequireSpecialChar Boolean  @default(true)
  defaultPageSize            Int      @default(10)
  logoExpandedUrl            String?
  logoCollapsedUrl           String?
  companyName                String?
  companyStreet              String?
  companyPostalCode          String?
  companyCity                String?
  companyCountry             String?
  companyRepresentative      String?
  companyEmail               String?
  companyPhone               String?
  companyRegisterCourt       String?
  companyRegisterNumber      String?
  companyVatId               String?
  updatedAt                  DateTime @updatedAt

  @@map("app_settings")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  firstName       String?
  lastName        String
  avatarUrl       String?
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  contents                Content[]                @relation("ContentAuthor")
  lockedContents          Content[]                @relation("ContentLockedBy")
  createdPreviewTokens    ContentPreviewToken[]
  contentVersions         ContentVersion[]
  media                   Media[]
  auditLogs               AuditLog[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

// ---------- Content ----------

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model ContentType {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  // JSON-Schema-artige Feld-Definition fuer flexible Content-Modelle
  schema    Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  contents  Content[]

  @@map("content_types")
}

// Modul-Typ für den Seiten-Designer (Drag&Drop-Bausteine, siehe
// knowledge-base/content/page-designer.md). Gleiche Schema-Form wie
// ContentType.schema ({ fields: [{name,type,required}] }), damit die
// vorhandene dynamische Formular-Generierung wiederverwendet werden
// kann. Modul-Instanzen selbst leben (wie andere dynamische
// Feldwerte auch) eingebettet in Content.data, keine eigene Tabelle.
model ModuleType {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  schema    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("module_types")
}

model Content {
  id          String        @id @default(cuid())
  title       String
  slug        String
  status      ContentStatus @default(DRAFT)
  locale      String        @default("de")
  data        Json
  excerpt     String?
  seoTitle    String?
  seoDescription String?
  canonicalUrl   String?
  ogTitle        String?
  ogDescription  String?
  ogImageUrl     String?
  twitterCard    String?
  robotsIndex    Boolean   @default(true)
  robotsFollow   Boolean   @default(true)
  scheduledFor   DateTime?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  contentTypeId String
  contentType   ContentType @relation(fields: [contentTypeId], references: [id])

  authorId String
  author   User   @relation("ContentAuthor", fields: [authorId], references: [id])

  lockedById String?
  lockedBy   User?     @relation("ContentLockedBy", fields: [lockedById], references: [id])
  lockedAt   DateTime?

  versions        ContentVersion[]
  categories      ContentCategory[]
  tags            ContentTag[]
  previewTokens   ContentPreviewToken[]
  navigationItems NavigationItem[]

  @@unique([slug, locale])
  @@index([status])
  @@map("contents")
}

model ContentPreviewToken {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@map("content_preview_tokens")
}

model ContentVersion {
  id        String   @id @default(cuid())
  contentId String
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime @default(now())

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@map("content_versions")
}

model Category {
  id          String            @id @default(cuid())
  name        String            @unique
  slug        String            @unique
  description String?
  contents    ContentCategory[]

  @@map("categories")
}

model ContentCategory {
  contentId  String
  categoryId String
  content    Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([contentId, categoryId])
  @@map("content_categories")
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique
  contents ContentTag[]

  @@map("tags")
}

model ContentTag {
  contentId String
  tagId     String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentId, tagId])
  @@map("content_tags")
}

// ---------- Navigation ----------

model Navigation {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items NavigationItem[]

  @@map("navigations")
}

model NavigationItem {
  id          String   @id @default(cuid())
  label       String
  externalUrl String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  navigationId String
  navigation   Navigation @relation(fields: [navigationId], references: [id], onDelete: Cascade)

  // Ziel entweder ein Inhalt ODER eine externe URL (App-Ebene validiert,
  // dass genau eines von beidem gesetzt ist – siehe NavigationService).
  contentId String?
  content   Content? @relation(fields: [contentId], references: [id], onDelete: SetNull)

  parentId String?
  parent   NavigationItem?  @relation("NavigationItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children NavigationItem[] @relation("NavigationItemHierarchy")

  @@index([navigationId])
  @@index([parentId])
  @@map("navigation_items")
}

// ---------- Medien ----------

model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  isSystem  Boolean       @default(false)
  parent    MediaFolder?  @relation("MediaFolderChildren", fields: [parentId], references: [id])
  children  MediaFolder[] @relation("MediaFolderChildren")
  media     Media[]
  createdAt DateTime      @default(now())

  @@map("media_folders")
}

model Media {
  id          String   @id @default(cuid())
  filename    String
  url         String
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  alt         String?
  createdAt   DateTime @default(now())

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  folderId String?
  folder   MediaFolder? @relation(fields: [folderId], references: [id])

  @@map("media")
}

// ---------- Audit Log ----------

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------- Webhooks ----------

model Webhook {
  id        String   @id @default(cuid())
  url       String
  events    String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("webhooks")
}
