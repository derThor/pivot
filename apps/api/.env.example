NODE_ENV=development
PORT=3001
DATABASE_URL="postgresql://pivot:pivot@localhost:5432/pivot?schema=public"
JWT_ACCESS_SECRET="change-me-to-a-random-32-plus-character-secret"
JWT_REFRESH_SECRET="change-me-to-a-different-random-32-plus-character-secret"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Origin der Web-App für den CORS-Header – nur Schema+Host, kein Pfad.
CORS_ORIGIN=http://localhost:3000
# Basis für Links, die im Backend geöffnet werden (Passwort-Reset,
# E-Mail-Verifikation, Benachrichtigungen). Nötig, weil das Backend unter
# einem Pfad derselben Domain liegt (https://kunde.de/admin) – siehe
# knowledge-base/platform/deployment.md. Ohne Wert wird CORS_ORIGIN benutzt.
ADMIN_BASE_URL=http://localhost:3000/admin
# 64 Hex-Zeichen (32 Byte) für AES-256-GCM, z.B. per:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENCRYPTION_KEY="change-me-to-a-random-64-character-hex-string-0000000000000000"

# Master/Slave-Modus wird seit 2026-08-24 unter Einstellungen (Pivot-Admin)
# umgeschaltet, nicht mehr per Umgebungsvariable – siehe
# knowledge-base/platform/master-slave-licensing.md.

# Nur im Master-Modus nötig: Ed25519-Signierschlüssel für Lizenz-Tokens,
# Base64-kodiertes PKCS8-DER. Erzeugen per:
# node -e "console.log(require('crypto').generateKeyPairSync('ed25519').privateKey.export({type:'pkcs8',format:'der'}).toString('base64'))"
LICENSE_SIGNING_PRIVATE_KEY=""

# Nur im Slave-Modus nötig – Werte kommen aus der Master-Installation
# (Einstellungen > Websites > Bearbeiten-Dialog beim Anlegen der Site).
# Basis-URL der Master-API (kein trailing slash), Domain, unter der DIESE
# Installation registriert ist, der dafür ausgestellte API-Key, und der
# öffentliche Signier-Schlüssel des Masters (aus dem Anlegen-Dialog oder
# GET /websites/public-key).
LICENSE_MASTER_URL="https://master.example.com/v1"
LICENSE_SITE_DOMAIN="strasev.de"
LICENSE_API_KEY=""
LICENSE_MASTER_PUBLIC_KEY=""
